---
import { SITE } from '../config';

const year = new Date().getFullYear();

const colonnes: { titre: string; liens: { label: string; href: string }[] }[] = [
  {
    titre: 'Outils',
    liens: [
      { label: 'Quiz de recommandation', href: '/outils/quiz' },
      { label: "Simulateur d'échéance", href: '/outils/echeance' },
      { label: 'Vérificateur de facture', href: '/outils/verificateur-facture' },
      { label: 'Plateformes agréées', href: '/plateformes-agreees' },
      { label: 'Newsletter', href: '/newsletter' },
    ],
  },
  {
    titre: 'Confiance',
    liens: [
      { label: 'Notre méthode', href: '/methode' },
      { label: 'Transparence', href: '/transparence' },
      { label: 'Annoncer sur le site', href: '/publicite' },
      { label: 'À propos', href: '/a-propos' },
    ],
  },
  {
    titre: 'Légal',
    liens: [
      { label: 'Mentions légales', href: '/mentions-legales' },
      { label: 'Confidentialité', href: '/confidentialite' },
    ],
  },
];
---

<footer class="site-footer mt-20">
  <div class="mx-auto max-w-5xl px-4 py-10 text-sm">
    <nav aria-label="Pied de page" class="grid gap-8 sm:grid-cols-3">
      {colonnes.map((c) => (
        <div>
          <p class="etiquette">{c.titre}</p>
          <ul class="mt-2 space-y-1">
            {c.liens.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <p class="mt-8 max-w-2xl text-ink-soft">
      Ces pages donnent une information générale. Pour votre situation, consultez votre
      expert-comptable.
    </p>
    <p class="mt-2 text-ink-soft">
      © {year} {SITE.name}
    </p>
  </div>
</footer>
