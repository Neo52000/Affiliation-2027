---
import { SITE } from '../config';

const year = new Date().getFullYear();

const colonnes: { titre: string; liens: { label: string; href: string }[] }[] = [
  {
    titre: 'Outils',
    liens: [
      { label: 'Quiz de recommandation', href: '/outils/quiz' },
      { label: "Simulateur d'échéance", href: '/outils/echeance' },
      { label: 'Vérificateur de facture', href: '/outils/verificateur-facture' },
      { label: 'Plateformes agréées', href: '/plateformes-agreees' },
    ],
  },
  {
    titre: 'Confiance',
    liens: [
      { label: 'Notre méthode', href: '/methode' },
      { label: 'Transparence', href: '/transparence' },
      { label: 'À propos', href: '/a-propos' },
    ],
  },
  {
    titre: 'Légal',
    liens: [
      { label: 'Mentions légales', href: '/mentions-legales' },
      { label: 'Confidentialité', href: '/confidentialite' },
    ],
  },
];
---

<footer class="mt-16 border-t border-border bg-paper-soft">
  <div class="mx-auto max-w-5xl px-4 py-8 text-sm">
    <nav aria-label="Pied de page" class="grid gap-6 sm:grid-cols-3">
      {colonnes.map((c) => (
        <div>
          <p class="font-bold text-ink">{c.titre}</p>
          <ul class="mt-2 space-y-1">
            {c.liens.map((l) => (
              <li>
                <a href={l.href} class="text-ink-soft">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <p class="mt-6 text-ink-soft">
      Information générale : ce site ne remplace pas l'avis de votre expert-comptable.
    </p>
    <p class="mt-2 text-ink-soft">
      © {year} {SITE.name}
    </p>
  </div>
</footer>
