---
import { SITE } from '../config';

// La navigation ne pointe que vers des pages qui existent. Visible à toutes les
// largeurs : trois liens tiennent sur une ligne, ou passent sous le nom du site.
const nav: { label: string; href: string }[] = [
  { label: 'Guides', href: '/guides' },
  { label: 'Plateformes', href: '/plateformes-agreees' },
  { label: 'Méthode', href: '/methode' },
];
const chemin = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const actif = (href: string) => chemin === href || chemin.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-8 gap-y-2 px-4 py-4">
    <a href="/" class="marque">
      {SITE.name}
    </a>
    <nav aria-label="Navigation principale">
      <ul class="flex flex-wrap gap-x-5 sm:gap-x-6 gap-y-1">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link"
              aria-current={actif(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
