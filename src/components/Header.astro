---
import { SITE } from '../config';
// La navigation ne pointe que vers des pages qui existent : les guides y
// sont entrés quand la collection a été publiée.
const nav: { label: string; href: string }[] = [
  { label: 'Guides', href: '/guides' },
  { label: 'Plateformes agréées', href: '/plateformes-agreees' },
  { label: 'Méthode', href: '/methode' },
];
---

<header class="site-header border-b border-border bg-paper">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="min-w-0 truncate font-bold text-ink no-underline hover:text-accent">
      {SITE.name}
    </a>
    <nav aria-label="Navigation principale" class="flex shrink-0 items-center gap-6">
      <ul class="hidden items-center gap-6 sm:flex">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="nav-link text-ink-soft no-underline hover:text-accent">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/outils/quiz" class="btn-cta text-sm">
        Trouver mon logiciel
      </a>
    </nav>
  </div>
</header>

<script>
  // L'ombre du header collant n'apparaît qu'au défilement (design system, Mouvement).
  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 4);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>
