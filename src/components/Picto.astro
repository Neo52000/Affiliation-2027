---
/**
 * Pictogrammes SVG inline (trait 1.8, currentColor) : zéro requête réseau,
 * rendu net à toute taille, couleurs héritées donc compatibles mode sombre.
 * Toujours décoratifs (aria-hidden) : le texte voisin porte le sens.
 * Les tracés vivent dans src/lib/pictos.ts (partagés avec la présentation).
 */
import { TRACES, type NomPicto } from '../lib/pictos';

export type { NomPicto };

interface Props {
  nom: NomPicto;
  class?: string | undefined;
  /** Côté en pixels (largeur = hauteur), 24 par défaut */
  taille?: number | undefined;
}

const { nom, class: className, taille = 24 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={TRACES[nom]}
/>
