---
/**
 * Illustration du hero : une facture transmise via une plateforme agréée
 * jusqu'à son destinataire. SVG inline décoratif, couleurs par variables CSS
 * (thème clair/sombre automatique), aucune requête réseau.
 */
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 460 340"
  width="460"
  height="340"
  fill="none"
  aria-hidden="true"
  class="hero-illu"
>
  <defs>
    <linearGradient id="illu-ga" x1="0" y1="0" x2="460" y2="340" gradientUnits="userSpaceOnUse">
      <stop stop-color="var(--color-accent)"></stop>
      <stop offset="1" stop-color="var(--color-accent-2)"></stop>
    </linearGradient>
  </defs>

  <!-- halos décoratifs -->
  <circle cx="92" cy="60" r="44" fill="var(--color-accent-soft)"></circle>
  <circle cx="408" cy="282" r="36" fill="var(--color-accent-soft)"></circle>
  <path
    d="M372 56h14M379 49v14M52 268h12M58 262v12"
    stroke="var(--color-accent-2)"
    stroke-width="2.5"
    stroke-linecap="round"
  ></path>

  <!-- facture émise -->
  <rect
    x="36"
    y="46"
    width="196"
    height="252"
    rx="16"
    fill="var(--color-paper)"
    stroke="var(--color-border)"
    stroke-width="2"
  ></rect>
  <rect x="36" y="46" width="196" height="8" rx="4" fill="url(#illu-ga)"></rect>
  <rect
    x="62"
    y="80"
    width="92"
    height="12"
    rx="6"
    fill="var(--color-accent)"
    opacity="0.85"
  ></rect>
  <rect x="62" y="108" width="144" height="9" rx="4.5" fill="var(--color-border)"></rect>
  <rect x="62" y="128" width="120" height="9" rx="4.5" fill="var(--color-border)"></rect>
  <rect x="62" y="148" width="132" height="9" rx="4.5" fill="var(--color-border)"></rect>
  <line x1="62" y1="178" x2="206" y2="178" stroke="var(--color-border)" stroke-width="2"></line>
  <rect x="62" y="194" width="64" height="10" rx="5" fill="var(--color-border)"></rect>
  <rect x="150" y="190" width="56" height="18" rx="9" fill="url(#illu-ga)" opacity="0.9"></rect>
  <circle cx="76" cy="246" r="17" stroke="url(#illu-ga)" stroke-width="2.5"></circle>
  <text
    x="76"
    y="252"
    text-anchor="middle"
    font-size="17"
    font-weight="700"
    fill="var(--color-accent)"
  >
    €
  </text>

  <!-- coche de conformité sur la facture -->
  <circle cx="226" cy="96" r="25" fill="url(#illu-ga)"></circle>
  <path
    d="m216 96 7 7 13-13"
    stroke="#ffffff"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>

  <!-- flux vers la plateforme agréée puis le destinataire -->
  <path
    d="M240 200c36 0 42 -44 78 -44"
    stroke="url(#illu-ga)"
    stroke-width="3"
    stroke-dasharray="2 9"
    stroke-linecap="round"
  ></path>
  <path
    d="M352 180c0 36 -4 62 -34 76"
    stroke="url(#illu-ga)"
    stroke-width="3"
    stroke-dasharray="2 9"
    stroke-linecap="round"
  ></path>

  <!-- nœud plateforme agréée -->
  <rect
    x="322"
    y="126"
    width="60"
    height="60"
    rx="16"
    transform="rotate(45 352 156)"
    fill="url(#illu-ga)"
  ></rect>
  <text x="352" y="162" text-anchor="middle" font-size="17" font-weight="800" fill="#ffffff">
    PA
  </text>

  <!-- facture reçue -->
  <rect
    x="252"
    y="240"
    width="112"
    height="76"
    rx="12"
    fill="var(--color-paper)"
    stroke="var(--color-border)"
    stroke-width="2"
  ></rect>
  <rect x="268" y="258" width="58" height="8" rx="4" fill="var(--color-border)"></rect>
  <rect x="268" y="276" width="44" height="8" rx="4" fill="var(--color-border)"></rect>
  <circle
    cx="344"
    cy="290"
    r="12"
    fill="var(--color-ok-soft)"
    stroke="var(--color-ok)"
    stroke-width="2"
  ></circle>
  <path
    d="m339 290 3.5 3.5 6.5-6.5"
    stroke="var(--color-ok)"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>

<style>
  .hero-illu {
    max-width: 100%;
    height: auto;
    font-family: inherit;
  }
</style>
