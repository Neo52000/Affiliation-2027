---
import type { z } from 'astro/zod';
import type { outilSchema } from '../lib/schemas';
import Statut from './Statut.astro';
import { libelleStatutTest } from '../lib/statut-test';

type Outil = z.infer<typeof outilSchema>;

interface Props {
  outils: Outil[];
}

const { outils } = Astro.props;

/** Une ligne rend soit un statut (icône + texte), soit du texte libre. */
type Ligne =
  | { label: string; type: 'statut'; valeur: (o: Outil) => boolean | null }
  | { label: string; type: 'texte'; valeur: (o: Outil) => string }
  | { label: string; type: 'note'; valeur: (o: Outil) => string };

const lignes: Ligne[] = [
  {
    label: 'Plateforme agréée (registre DGFiP)',
    type: 'statut',
    valeur: (o) => o.est_plateforme_agreee.valeur,
  },
  { label: 'Pour qui (cible de l’éditeur)', type: 'texte', valeur: (o) => o.cible.join(', ') },
  { label: 'Comptabilité intégrée', type: 'statut', valeur: (o) => o.fonctionnalites.compta },
  { label: 'Compte professionnel', type: 'statut', valeur: (o) => o.fonctionnalites.compte_pro },
  {
    label: 'Note',
    type: 'note',
    valeur: (o) =>
      o.statut_test === 'a_tester'
        ? libelleStatutTest(o.statut_test)
        : String(o.notes.finale ?? '—'),
  },
];
---

<div class="table-scroll rounded-lg border border-border px-4 py-2">
  <table class="table-interactive w-full border-collapse text-sm">
    <thead>
      <tr class="border-b-2 border-border text-left">
        <th scope="col" class="py-2 pr-3">
          <span class="sr-only">Critère</span>
        </th>
        {outils.map((o) => (
          <th scope="col" class="py-2 pr-3 font-bold">
            <a href={`/logiciels/${o.slug}`}>{o.nom}</a>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {lignes.map((l) => (
        <tr class="border-b border-border">
          <th scope="row" class="py-2 pr-3 text-left font-normal text-ink-soft">
            {l.label}
          </th>
          {outils.map((o) => (
            <td class="py-2 pr-3">
              {l.type === 'statut' ? (
                <Statut valeur={l.valeur(o)} />
              ) : l.type === 'note' ? (
                <span class="pill">{l.valeur(o)}</span>
              ) : (
                l.valeur(o)
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="mt-2 text-xs text-ink-soft">
  « À vérifier » : donnée en cours de relevé sur le site officiel de l'éditeur. Aucune note n'est
  attribuée avant notre test réel documenté.
</p>
