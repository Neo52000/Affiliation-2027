---
import type { z } from 'astro/zod';
import type { outilSchema } from '../lib/schemas';

type Outil = z.infer<typeof outilSchema>;

interface Props {
  outils: Outil[];
}

const { outils } = Astro.props;

const cell = (v: boolean | null) => (v === true ? 'Oui' : v === false ? 'Non' : 'À vérifier');

const lignes: { label: string; valeur: (o: Outil) => string }[] = [
  {
    label: 'Plateforme agréée (registre DGFiP)',
    valeur: (o) => (o.est_plateforme_agreee.valeur ? 'Oui' : 'Non'),
  },
  { label: 'Pour qui (cible de l’éditeur)', valeur: (o) => o.cible.join(', ') },
  { label: 'Comptabilité intégrée', valeur: (o) => cell(o.fonctionnalites.compta) },
  { label: 'Compte professionnel', valeur: (o) => cell(o.fonctionnalites.compte_pro) },
  {
    label: 'Note',
    valeur: (o) => (o.statut_test === 'a_tester' ? 'Test en cours' : String(o.notes.finale ?? '—')),
  },
];
---

<div class="table-scroll rounded-lg border border-border px-4 py-2">
  <table class="table-interactive w-full border-collapse text-sm">
    <thead>
      <tr class="border-b-2 border-border text-left">
        <th scope="col" class="py-2 pr-3">
          <span class="sr-only">Critère</span>
        </th>
        {outils.map((o) => (
          <th scope="col" class="py-2 pr-3">
            <a href={`/logiciels/${o.slug}`}>{o.nom}</a>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {lignes.map((l) => (
        <tr class="border-b border-border">
          <th scope="row" class="py-2 pr-3 text-left font-normal text-ink-soft">
            {l.label}
          </th>
          {outils.map((o) => (
            <td class="py-2 pr-3">
              {l.valeur(o) === 'Test en cours' ? (
                <span class="pill">Test en cours</span>
              ) : (
                l.valeur(o)
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="mt-2 text-xs text-ink-soft">
  « À vérifier » : donnée en cours de relevé sur le site officiel de l'éditeur. Aucune note n'est
  attribuée avant notre test réel documenté.
</p>
