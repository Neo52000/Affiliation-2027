---
/**
 * Téléscripteur des familles de métiers : chaque nom mène à son hub.
 * Par défaut, liste statique sur plusieurs lignes. Le défilement n'existe que
 * sous html.anim-on (motion.css) : il se met en pause au survol et au focus
 * pointeur, s'arrête au focus clavier et disparaît avec le bouton pause ou
 * prefers-reduced-motion. Le second groupe n'est qu'un doublon visuel de la
 * boucle : masqué aux technologies d'assistance (aria-hidden) et hors de l'ordre
 * de tabulation (tabindex=-1), mais cliquable comme ce qu'il montre.
 */
import { FAMILLE_LABELS, type Famille } from '../lib/familles';

interface Props {
  familles: Famille[];
}

const { familles } = Astro.props;
const items = familles.map((f) => ({ href: `/metiers/${f}`, label: FAMILLE_LABELS[f] }));
---

<section class="m-defile" aria-label="Les familles de métiers couvertes" data-defile>
  <div class="m-defile-piste">
    <ul class="m-defile-groupe">
      {items.map((i) => (
        <li>
          <a href={i.href}>{i.label}</a>
        </li>
      ))}
    </ul>
    <ul class="m-defile-groupe" aria-hidden="true">
      {items.map((i) => (
        <li>
          <a href={i.href} tabindex="-1">
            {i.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Au focus, le bandeau défile jusqu'au lien pour l'afficher entier
  // (WCAG 2.4.11) ; au départ du focus, il revient au début pour que la boucle
  // reprenne sans trou.
  for (const defile of document.querySelectorAll<HTMLElement>('[data-defile]')) {
    defile.addEventListener('focusin', (e) => {
      const lien = e.target as HTMLElement;
      // Clavier seulement : au clic, déplacer le lien sous le curseur perdrait le clic.
      if (lien.matches(':focus-visible'))
        lien.scrollIntoView({ inline: 'center', block: 'nearest' });
    });
    defile.addEventListener('focusout', (e) => {
      if (!defile.contains(e.relatedTarget as Node | null)) defile.scrollLeft = 0;
    });
  }
</script>
