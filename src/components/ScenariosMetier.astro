---
/**
 * Scénarios de facturation d'un métier : étapes concrètes, exemple chiffré et,
 * pour chaque logiciel recommandé, la disponibilité déclarée de la fonctionnalité
 * exigée (fiches outils). Aucun résultat de test n'est affiché avant nos essais.
 */
import type { CollectionEntry } from 'astro:content';
import Statut from './Statut.astro';

type Scenario = NonNullable<CollectionEntry<'metiers'>['data']['scenarios']>[number];

interface Props {
  scenarios: Scenario[];
  outils: CollectionEntry<'outils'>[];
}

const { scenarios, outils } = Astro.props;

const LIBELLES: Record<Scenario['fonction'], string> = {
  devis: 'Devis',
  acomptes: 'Factures d’acompte',
  export_comptable: 'Export comptable',
  lien_expert_comptable: 'Accès expert-comptable',
};
---

<section aria-labelledby="scenarios" class="mt-10">
  <h2 id="scenarios" class="titre-section">
    Nos scénarios de facturation
  </h2>
  <p class="prose-measure mt-3 text-sm text-ink-soft">
    Les parcours que le logiciel doit permettre, de la commande à la transmission au comptable. Le
    tableau indique la disponibilité déclarée par chaque éditeur ; nos propres essais de ces
    parcours sont à venir.
  </p>

  <ol class="mt-4">
    {scenarios.map((s) => (
      <li class="border-t border-border py-5">
        <h3 class="text-lg">{s.titre}</h3>
        <p class="prose-measure mt-1">{s.objectif}</p>
        <ol class="prose-measure mt-3 list-decimal space-y-1 pl-5">
          {s.etapes.map((e) => (
            <li>{e}</li>
          ))}
        </ol>
        <p class="prose-measure mt-3 text-sm">
          <span class="font-semibold">Exemple chiffré&nbsp;:</span> {s.exemple}
        </p>
      </li>
    ))}
  </ol>

  <div
    class="table-scroll mt-6"
    role="region"
    aria-label="Disponibilité des fonctions par logiciel"
    tabindex="0"
  >
    <table class="w-full border-collapse text-sm">
      <caption class="sr-only">
        Fonction exigée par chaque scénario et disponibilité déclarée par l’éditeur
      </caption>
      <thead>
        <tr>
          <th scope="col" class="py-2 pr-3 text-left">
            Scénario
          </th>
          {outils.map((o) => (
            <th scope="col" class="py-2 pr-3 text-left">
              <a href={`/logiciels/${o.data.slug}`}>{o.data.nom}</a>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {scenarios.map((s) => (
          <tr class="border-t border-border">
            <th scope="row" class="py-2 pr-3 text-left font-normal">
              {s.titre.replace(/^\d+\.\s*/, '')}
              <span class="block text-xs text-ink-soft">{LIBELLES[s.fonction]}</span>
            </th>
            {outils.map((o) => (
              <td class="py-2 pr-3">
                <Statut valeur={o.data.fonctionnalites[s.fonction]} />
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-2 text-xs text-ink-soft">
    « À vérifier » : donnée en cours de relevé sur le site officiel de l’éditeur.
  </p>
</section>
