---
/**
 * Chiffre clé avec compteur. La valeur réelle est rendue dans le HTML : sans
 * JavaScript, en mouvement réduit ou en pause, elle s'affiche telle quelle.
 * Le compte (Base.astro) part de 0 quand la tuile apparaît ; il est masqué aux
 * lecteurs d'écran, qui lisent la valeur en texte. Le fantôme invisible réserve
 * la largeur finale : aucun décalage pendant le compte.
 */
interface Props {
  valeur: number;
  libelle: string;
}

const { valeur, libelle } = Astro.props;
const affiche = new Intl.NumberFormat('fr-FR').format(valeur);
---

<li class="stat-tile">
  <p class="stat-valeur">
    <span class="sr-only">{affiche}</span>
    <span class="m-compteur" aria-hidden="true">
      <span class="m-compteur-fantome">{affiche}</span>
      <span class="text-gradient" data-compteur={valeur}>
        {affiche}
      </span>
    </span>
  </p>
  <p class="text-sm text-ink-soft">{libelle}</p>
</li>
