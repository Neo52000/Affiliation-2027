---
interface Ligne {
  designation: string;
  quantite: number;
  unite: string;
  /** Négatif = ligne de déduction ; null = montant au tarif réglementé, non reproduit. */
  prix_unitaire_ht: number | null;
  /** null = hors champ de la TVA (franchise en base, débours). */
  tva_pct: number | null;
}

interface Props {
  intitule: string;
  lignes: Ligne[];
  mentions: string[];
}

const { intitule, lignes, mentions } = Astro.props;

const euros = (n: number) =>
  n.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

// Les totaux ne s'affichent que si chaque ligne porte un montant : une facture dont
// une ligne relève d'un tarif réglementé non reproduit n'a pas de total juste.
const montantsComplets = lignes.every((l) => l.prix_unitaire_ht !== null);
const horsChampTva = lignes.some((l) => l.tva_pct === null);

const totalHt = lignes.reduce((s, l) => s + l.quantite * (l.prix_unitaire_ht ?? 0), 0);
const totalTva = lignes.reduce(
  (s, l) => s + (l.quantite * (l.prix_unitaire_ht ?? 0) * (l.tva_pct ?? 0)) / 100,
  0,
);
---

<figure>
  <figcaption class="mb-2 text-sm text-ink-soft">
    {intitule} — exemple illustratif (montants fictifs, taux de TVA réels)
  </figcaption>
  <div
    class="table-scroll rounded-lg border border-border px-4 py-2"
    role="region"
    aria-label="Lignes de la facture"
    tabindex="0"
  >
    <table class="table-interactive table-chiffres w-full border-collapse text-sm">
      <thead>
        <tr class="border-b-2 border-border text-left">
          <th scope="col" class="designation py-2 pr-3">
            Désignation
          </th>
          <th scope="col" class="nombre py-2 pr-3">
            Qté
          </th>
          <th scope="col" class="py-2 pr-3">
            Unité
          </th>
          <th scope="col" class="nombre py-2 pr-3">
            PU HT
          </th>
          <th scope="col" class="nombre py-2 pr-3">
            TVA
          </th>
          <th scope="col" class="nombre py-2">
            Total HT
          </th>
        </tr>
      </thead>
      <tbody>
        {lignes.map((l) => (
          <tr class="border-b border-border">
            <td class="designation py-2 pr-3">{l.designation}</td>
            <td class="nombre py-2 pr-3">{l.quantite.toLocaleString('fr-FR')}</td>
            <td class="py-2 pr-3">{l.unite}</td>
            <td class="nombre py-2 pr-3">
              {l.prix_unitaire_ht === null ? 'tarif réglementé' : `${euros(l.prix_unitaire_ht)} €`}
            </td>
            <td class="nombre py-2 pr-3">
              {l.tva_pct === null ? '—' : `${l.tva_pct.toLocaleString('fr-FR')} %`}
            </td>
            <td class="nombre py-2">
              {l.prix_unitaire_ht === null ? '—' : `${euros(l.quantite * l.prix_unitaire_ht)} €`}
            </td>
          </tr>
        ))}
      </tbody>
      {montantsComplets && (
        <tfoot>
          <tr class="border-b border-border">
            <th scope="row" colspan="5" class="nombre py-2 pr-3 font-normal">
              Total HT
            </th>
            <td class="nombre py-2 font-bold">{euros(totalHt)} €</td>
          </tr>
          {!horsChampTva && (
            <tr class="border-b border-border">
              <th scope="row" colspan="5" class="nombre py-2 pr-3 font-normal">
                TVA
              </th>
              <td class="nombre py-2">{euros(totalTva)} €</td>
            </tr>
          )}
          {!horsChampTva && (
            <tr>
              <th scope="row" colspan="5" class="nombre py-2 pr-3 font-normal">
                Total TTC
              </th>
              <td class="nombre py-2 font-bold">{euros(totalHt + totalTva)} €</td>
            </tr>
          )}
        </tfoot>
      )}
    </table>
  </div>
  {horsChampTva && (
    <p class="mt-2 text-xs text-ink-soft">
      « — » dans la colonne TVA : ligne hors champ de la taxe (franchise en base ou débours). Aucun
      taux ne doit alors figurer sur la facture.
    </p>
  )}
  {!montantsComplets && (
    <p class="mt-2 text-xs text-ink-soft">
      Les montants relevant d'un tarif réglementé ne sont pas reproduits ici : seule la structure de
      la facture est illustrée, et aucun total n'est calculé.
    </p>
  )}
  {mentions.length > 0 && (
    <div class="mt-3 text-sm text-ink-soft">
      <p class="font-bold">Mentions à faire figurer sur cette facture :</p>
      <ul class="mt-1 list-disc pl-5">
        {mentions.map((m) => (
          <li>{m}</li>
        ))}
      </ul>
    </div>
  )}
</figure>
