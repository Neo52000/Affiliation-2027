---
interface Ligne {
  designation: string;
  quantite: number;
  unite: string;
  prix_unitaire_ht: number;
  tva_pct: number;
}

interface Props {
  intitule: string;
  lignes: Ligne[];
  mentions: string[];
}

const { intitule, lignes, mentions } = Astro.props;

const euros = (n: number) =>
  n.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const totalHt = lignes.reduce((s, l) => s + l.quantite * l.prix_unitaire_ht, 0);
const totalTva = lignes.reduce(
  (s, l) => s + (l.quantite * l.prix_unitaire_ht * l.tva_pct) / 100,
  0,
);
---

<figure>
  <figcaption class="mb-2 text-sm text-ink-soft">
    {intitule} — exemple illustratif (montants fictifs, taux de TVA réels)
  </figcaption>
  <div class="table-scroll rounded-lg border border-border px-4 py-2">
    <table class="table-interactive w-full border-collapse text-sm">
      <thead>
        <tr class="border-b-2 border-border text-left">
          <th scope="col" class="py-2 pr-3">
            Désignation
          </th>
          <th scope="col" class="py-2 pr-3 text-right">
            Qté
          </th>
          <th scope="col" class="py-2 pr-3">
            Unité
          </th>
          <th scope="col" class="py-2 pr-3 text-right">
            PU HT
          </th>
          <th scope="col" class="py-2 pr-3 text-right">
            TVA
          </th>
          <th scope="col" class="py-2 text-right">
            Total HT
          </th>
        </tr>
      </thead>
      <tbody>
        {lignes.map((l) => (
          <tr class="border-b border-border">
            <td class="py-2 pr-3">{l.designation}</td>
            <td class="py-2 pr-3 text-right">{l.quantite}</td>
            <td class="py-2 pr-3">{l.unite}</td>
            <td class="py-2 pr-3 text-right">{euros(l.prix_unitaire_ht)} €</td>
            <td class="py-2 pr-3 text-right">{l.tva_pct.toLocaleString('fr-FR')} %</td>
            <td class="py-2 text-right">{euros(l.quantite * l.prix_unitaire_ht)} €</td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr class="border-b border-border">
          <th scope="row" colspan="5" class="py-2 pr-3 text-right font-normal">
            Total HT
          </th>
          <td class="py-2 text-right font-bold">{euros(totalHt)} €</td>
        </tr>
        <tr class="border-b border-border">
          <th scope="row" colspan="5" class="py-2 pr-3 text-right font-normal">
            TVA
          </th>
          <td class="py-2 text-right">{euros(totalTva)} €</td>
        </tr>
        <tr>
          <th scope="row" colspan="5" class="py-2 pr-3 text-right font-normal">
            Total TTC
          </th>
          <td class="py-2 text-right font-bold">{euros(totalHt + totalTva)} €</td>
        </tr>
      </tfoot>
    </table>
  </div>
  {mentions.length > 0 && (
    <div class="mt-3 text-sm text-ink-soft">
      <p class="font-bold">Mentions à faire figurer sur cette facture :</p>
      <ul class="mt-1 list-disc pl-5">
        {mentions.map((m) => (
          <li>{m}</li>
        ))}
      </ul>
    </div>
  )}
</figure>
