---
/**
 * Indicateur de disponibilité d'une fonctionnalité : icône + texte.
 * L'icône n'est jamais le seul signal (WCAG 1.4.1) : le libellé reste lisible.
 * null = donnée pas encore relevée à la source, jamais « non ».
 */
interface Props {
  valeur: boolean | null;
  /** Libellé affiché pour la valeur nulle */
  labelInconnu?: string | undefined;
}

const { valeur, labelInconnu = 'À vérifier' } = Astro.props;

const etat = valeur === true ? 'oui' : valeur === false ? 'non' : 'inconnu';
const label = valeur === true ? 'Oui' : valeur === false ? 'Non' : labelInconnu;

const TRACES: Record<string, string> = {
  oui: '<path d="m4.5 10 4 4 7-8"/>',
  non: '<path d="M5 5l10 10M15 5L5 15"/>',
  inconnu: '<path d="M5 10h10"/>',
};
---

<span class:list={['statut', `statut-${etat}`]}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 20 20"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={TRACES[etat]}
  />
  {label}
</span>
