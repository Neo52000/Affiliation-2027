---
/**
 * Cas concret d'une fiche métier (champ `scenario`, TODO.md #40) : les étapes
 * de facturation d'une situation type, croisées avec les fonctions relevées
 * dans la fiche de chaque logiciel recommandé. Une fonction non relevée reste
 * « À vérifier » : le tableau ne promet rien que les fiches n'établissent.
 */
import Statut from './Statut.astro';
import { LIBELLES_FONCTIONS_OUTIL } from '../lib/fonctions';
import type { FONCTIONS_OUTIL } from '../lib/schemas';

type Fonction = (typeof FONCTIONS_OUTIL)[number];

interface Props {
  metierNom: string;
  situation: string;
  etapes: { titre: string; detail: string; fonction: Fonction }[];
  outils: { slug: string; nom: string; fonctionnalites: Record<Fonction, boolean | null> }[];
}

const { metierNom, situation, etapes, outils } = Astro.props;
---

<section aria-labelledby="cas-concret" class="mt-10">
  <h2 id="cas-concret" class="titre-section">
    Cas concret : {metierNom.toLowerCase()}
  </h2>
  <p class="mt-3">{situation}</p>
  <ol class="mt-4 list-decimal space-y-2 pl-5">
    {etapes.map((e) => (
      <li>
        <strong>{e.titre}.</strong> {e.detail}
      </li>
    ))}
  </ol>
  {outils.length > 0 && (
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm">
        <caption class="mb-2 text-left text-ink-soft">
          Ce que les fiches des logiciels recommandés établissent pour chaque étape (« À vérifier »
          : fonction pas encore relevée chez l’éditeur).
        </caption>
        <thead>
          <tr>
            <th scope="col" class="pr-4 text-left">
              Étape (fonction sollicitée)
            </th>
            {outils.map((o) => (
              <th scope="col" class="pr-4 text-left">
                <a href={`/logiciels/${o.slug}`}>{o.nom}</a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {etapes.map((e, i) => (
            <tr>
              <th scope="row" class="pr-4 text-left font-normal">
                {i + 1}. {e.titre} ({LIBELLES_FONCTIONS_OUTIL[e.fonction].toLowerCase()})
              </th>
              {outils.map((o) => (
                <td class="pr-4">
                  <Statut valeur={o.fonctionnalites[e.fonction]} />
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</section>
