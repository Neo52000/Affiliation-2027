---
import { SITE } from '../config';
import { canonicalUrl, jsonLdSur, validateMeta } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Date de mise à jour (balisage + affichage géré par les pages) */
  updatedAt?: Date | undefined;
  noindex?: boolean | undefined;
}

const { title, description, updatedAt, noindex = false } = Astro.props;

const site = (Astro.site ?? new URL(SITE.url)).toString();
const canonical = canonicalUrl(site, Astro.url.pathname);

if (import.meta.env.DEV) {
  for (const v of validateMeta(title, description)) {
    console.warn(`[seo] ${Astro.url.pathname} : ${v}`);
  }
}
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:image" content={new URL('/og.png', site).toString()} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Facturation électronique : le bon logiciel pour votre métier. Échéances, mentions obligatoires et logiciels adaptés, avec leurs sources officielles."
/>
<meta name="twitter:card" content="summary_large_image" />
{updatedAt && <meta property="og:updated_time" content={updatedAt.toISOString()} />}

{/* JSON-LD Organization + WebSite sur toutes les pages (section 9) */}
<script
  type="application/ld+json"
  is:inline
  set:html={jsonLdSur([
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': `${site}#organisation`,
      name: SITE.name,
      url: site,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': `${site}#site`,
      name: SITE.name,
      url: site,
      inLanguage: 'fr-FR',
      publisher: { '@id': `${site}#organisation` },
    },
  ])}
/>
