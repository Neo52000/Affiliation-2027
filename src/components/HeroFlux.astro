---
/**
 * Illustration du hero : une facture rejoint une plateforme agréée.
 * Décorative (aria-hidden) : aucun montant, numéro ni nom d'entreprise, la
 * facture est marquée « Exemple ». Cadre fixe 400 × 360, affiché à partir de lg
 * par la page. Les boucles (tirets, jeton, balayage, flottement) n'existent que
 * sous html.anim-on ; l'état de base est l'image finale, tampon tracé.
 */
---

<div class="m-scene" aria-hidden="true">
  <svg class="m-flux" viewBox="0 0 400 360" width="400" height="360">
    <path d="M 120 150 C 120 240 200 190 236 248"></path>
  </svg>
  <span class="m-jeton"></span>

  <div class="m-carte m-carte-a">
    <div class="m-carte-corps">
      <div class="flex items-center justify-between">
        <strong class="text-sm">Facture</strong>
        <span class="text-xs text-ink-soft">Exemple</span>
      </div>
      <div class="m-barre w-full"></div>
      <div class="m-barre w-4/5"></div>
      <div class="m-barre w-3/5"></div>
      <div class="mt-4 border-t border-border pt-1">
        <div class="m-barre ml-auto w-2/5"></div>
      </div>
    </div>
  </div>

  <div class="m-carte m-carte-b">
    <div class="m-carte-corps">
      <span class="badge-ok badge-icone">
        <svg
          class="m-tampon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12.5l4.5 4.5L19 7.5"></path>
        </svg>
        Plateforme agréée
      </span>
      <div class="m-barre mt-4 w-11/12"></div>
      <div class="m-barre w-1/2"></div>
    </div>
  </div>
</div>
