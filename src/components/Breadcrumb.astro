---
import { jsonLdSur } from '../lib/seo';
import { SITE } from '../config';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const site = (Astro.site ?? new URL(SITE.url)).toString().replace(/\/+$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site}/` },
    ...items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: item.label,
      ...(item.href ? { item: `${site}${item.href}` } : {}),
    })),
  ],
};
---

<script type="application/ld+json" is:inline set:html={jsonLdSur(jsonLd)} />
<nav aria-label="Fil d'Ariane" class="text-sm text-ink-soft">
  <ol class="flex flex-wrap items-center gap-1">
    <li>
      <a href="/" class="text-ink-soft hover:text-accent">
        Accueil
      </a>
    </li>
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        <span aria-hidden="true">›</span>
        {item.href && i < items.length - 1 ? (
          <a href={item.href} class="text-ink-soft hover:text-accent">
            {item.label}
          </a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
