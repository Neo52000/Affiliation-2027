---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Quiz from '../../components/islands/Quiz.tsx';
import BandeauTransparence from '../../components/BandeauTransparence.astro';
import { libelleStatutTest } from '../../lib/statut-test';
import { SITE } from '../../config';
import { pageTitle } from '../../lib/seo';

const metiersColl = await getCollection('metiers');
const outilsColl = await getCollection('outils');

const metiers = metiersColl
  .map((m) => ({ nom: m.data.nom, slug: m.data.slug }))
  .sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));

const recosParMetier = Object.fromEntries(
  metiersColl.map((m) => [m.data.slug, m.data.outils_recommandes.map((o) => o.slug)]),
);

const outils = outilsColl.map((o) => ({
  slug: o.data.slug,
  nom: o.data.nom,
  comptePro: o.data.fonctionnalites.compte_pro,
  compta: o.data.fonctionnalites.compta,
  lienExpertComptable: o.data.fonctionnalites.lien_expert_comptable,
  cibles: o.data.cible,
  urlOfficielle: o.data.url_officielle,
  libelleTest: libelleStatutTest(o.data.statut_test),
}));
---

<Base
  title={pageTitle('Quiz : quel logiciel pour vous ?', SITE.name)}
  description="Cinq questions (métier, statut, volume, compte pro, expert-comptable) pour trouver votre logiciel de facturation électronique, avec deux alternatives."
>
  <BandeauTransparence outils={outils.map((o) => o.slug)} rappelIndependance={false} />
  <Breadcrumb items={[{ label: 'Outils' }, { label: 'Quiz' }]} />
  <p class="surtitre mt-4">Outil</p>
  <h1 class="titre-page mt-3">Quel logiciel de facturation électronique pour vous&nbsp;?</h1>
  <p class="chapo mt-5">
    Répondez à cinq questions sur votre activité&nbsp;: le quiz recommande un logiciel et propose
    deux alternatives.
  </p>

  <div class="layout-article mt-10">
    <div class="max-w-2xl">
      <Quiz client:load metiers={metiers} outils={outils} recosParMetier={recosParMetier} />
    </div>

    <aside class="colonne-appui" aria-label="Ce que vaut cette recommandation">
      <div class="carte-appui">
        <p class="carte-appui-titre">Comment elle est calculée</p>
        <ul class="mt-2 space-y-2 text-sm text-ink-soft">
          <li>Votre métier détermine les besoins réellement utiles.</li>
          <li>Seuls les faits vérifiés de chaque logiciel entrent dans le calcul.</li>
          <li>Ni les commissions ni la publicité n'y entrent jamais.</li>
          <li>À égalité, l'ordre alphabétique départage.</li>
        </ul>
        <p class="mt-3 text-sm">
          <a href="/methode">Notre méthode en détail</a>
        </p>
      </div>

      <div class="carte-appui">
        <p class="carte-appui-titre">Pas encore de note</p>
        <p class="mt-2 text-sm text-ink-soft">
          Aucun logiciel n'est noté avant notre test. En attendant, la recommandation s'appuie sur
          le périmètre et la cible vérifiés.
        </p>
      </div>

      <div class="carte-appui">
        <p class="carte-appui-titre">Vos échéances</p>
        <p class="mt-2 text-sm text-ink-soft">
          Savoir à quelle date vous êtes concerné, selon votre situation.
        </p>
        <p class="mt-3 text-sm">
          <a href="/outils/echeance">Ouvrir le simulateur</a>
        </p>
      </div>
    </aside>
  </div>

  <noscript>
    <p class="prose-measure mt-6 border-t border-ink pt-4">
      Le quiz a besoin de JavaScript. Sans lui, passez par la page de votre métier : chacune
      recommande trois logiciels, avec les mêmes critères.{' '}
      <a href="/">Trouver votre métier depuis l'accueil</a>.
    </p>
  </noscript>
</Base>
