---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EcheanceSimulateur from '../../components/islands/EcheanceSimulateur.tsx';
import { SITE } from '../../config';
import { pageTitle } from '../../lib/seo';
import { formatDateFr } from '../../lib/dates';
import echeancesData from '../../data/echeances.json';
import type { Echeance } from '../../lib/echeance';

const echeances = echeancesData.echeances as Echeance[];
---

<Base
  title={pageTitle('Simulateur d’échéance', SITE.name)}
  description="Quand devez-vous recevoir et émettre des factures électroniques ? Indiquez la taille de votre entreprise et votre situation TVA : dates applicables et check-list."
>
  <Breadcrumb items={[{ label: 'Outils' }, { label: 'Simulateur d’échéance' }]} />
  <h1 class="prose-measure mt-4 text-3xl font-bold">Vos échéances de facturation électronique</h1>
  <p class="prose-measure mt-3">
    Indiquez votre situation : le simulateur affiche les dates qui s'appliquent à votre entreprise
    et votre check-list de mise en conformité.
  </p>

  <div class="mt-6">
    <EcheanceSimulateur client:load echeances={echeances} />
  </div>

  <section aria-labelledby="calendrier-complet" class="prose-measure mt-12">
    <h2 id="calendrier-complet" class="text-2xl font-bold">
      Le calendrier complet (sans simulateur)
    </h2>
    <div class="table-scroll mt-3">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="border-b-2 border-border text-left">
            <th scope="col" class="py-2 pr-3">
              Obligation
            </th>
            <th scope="col" class="py-2 pr-3">
              Qui
            </th>
            <th scope="col" class="py-2 pr-3">
              Date
            </th>
            <th scope="col" class="py-2">
              Statut
            </th>
          </tr>
        </thead>
        <tbody>
          {echeances.map((e) => (
            <tr class="border-b border-border">
              <td class="py-2 pr-3">{e.obligation}</td>
              <td class="py-2 pr-3">{e.concernes}</td>
              <td class="py-2 pr-3">{formatDateFr(e.date)}</td>
              <td class="py-2">{e.statut === 'en_vigueur' ? 'En vigueur' : 'À venir'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-ink-soft">
      Sources officielles :{' '}
      {echeancesData.base_legale.slice(0, 2).map((b, i) => (
        <>
          {i > 0 && ' · '}
          <a href={b.url} rel="noopener">
            {b.texte.split('(')[0]}
          </a>
        </>
      ))}
      — données relevées le {formatDateFr(echeancesData.date_releve)}.
    </p>
  </section>
</Base>
