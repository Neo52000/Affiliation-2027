---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VerificateurFacture from '../../components/islands/VerificateurFacture.tsx';
import { SITE } from '../../config';
import { pageTitle } from '../../lib/seo';
import { formatDateFr } from '../../lib/dates';
import mentionsData from '../../data/mentions-factures.json';
import type { MentionFacture } from '../../lib/facture-check';

const mentions = mentionsData.mentions as MentionFacture[];
---

<Base
  title={pageTitle('Vérificateur de facture', SITE.name)}
  description="Cochez les mentions présentes sur votre facture : le vérificateur liste celles qui manquent, avec la règle et la source officielle. Aucune donnée envoyée."
>
  <Breadcrumb items={[{ label: 'Outils' }, { label: 'Vérificateur de facture' }]} />
  <p class="surtitre mt-4">Outil</p>
  <h1 class="titre-page mt-3">Votre facture est-elle conforme&nbsp;?</h1>
  <p class="chapo mt-5">
    Le vérificateur contrôle {mentions.length} mentions, chacune adossée à une source officielle.
    Relevé du {formatDateFr(mentionsData.date_releve)}.
  </p>

  <div class="mt-10 max-w-2xl">
    <VerificateurFacture client:load mentions={mentions} />
  </div>

  <noscript>
    <section class="prose-measure mt-8">
      <p class="border-t border-ink pt-4">
        Le vérificateur interactif a besoin de JavaScript. Sans lui, contrôlez votre facture avec la
        liste complète des mentions :
      </p>
      <ul class="liste-filets mt-2">
        {mentions.map((m) => (
          <li>
            {m.libelle}.{' '}
            <a href={m.url_source} rel="noopener">
              Source officielle
            </a>
            {m.condition && (
              <span class="block text-sm text-ink-soft">Condition&nbsp;: {m.condition}</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  </noscript>
</Base>
