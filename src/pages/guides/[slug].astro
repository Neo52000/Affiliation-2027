---
import { jsonLdSur } from '../../lib/seo';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EspacePublicitaire from '../../components/EspacePublicitaire.astro';
import InscriptionNewsletter from '../../components/InscriptionNewsletter.astro';
import { SITE } from '../../config';
import { formatDateFr } from '../../lib/dates';
import { insecables } from '../../lib/presentation';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { entry: g } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);

// Sommaire construit depuis les titres réels du guide : jamais une liste figée
// qui mentirait sur le contenu. Seuls les h2 structurent la navigation.
const sommaire = headings.filter((h) => h.depth === 2);

// Les autres guides, pour ne pas laisser la page sans suite.
const autresGuides = (await getCollection('guides'))
  .filter((g) => g.id !== entry.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr'))
  .slice(0, 4);

const site = (Astro.site ?? new URL(SITE.url)).toString().replace(/\/+$/, '');
// JSON-LD Article sur les guides (section 9).
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  inLanguage: 'fr-FR',
  dateModified: d.date_maj,
  mainEntityOfPage: `${site}/guides/${entry.id}`,
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@id': `${site}/#organisation` },
};
---

<Base title={d.title} description={d.description}>
  <script type="application/ld+json" is:inline set:html={jsonLdSur(articleJsonLd)} />
  <Breadcrumb items={[{ label: 'Guides' }, { label: d.title }]} />

  <div class="layout-article mt-4">
    <article>
      <p class="surtitre">Guide</p>
      <h1 class="titre-page mt-3">{insecables(d.title)}</h1>
      <p class="mt-3 text-sm text-ink-soft">
        Mis à jour le {formatDateFr(d.date_maj)}
        {SITE.expertRelecteur ? ` · Relu par ${SITE.expertRelecteur}` : ''} · {d.sources.length}
        {d.sources.length > 1 ? ' sources officielles' : ' source officielle'}
      </p>

      <p class="chapo mt-5">{insecables(d.description)}</p>

      {sommaire.length > 2 && (
        <nav aria-labelledby="sommaire-mobile" class="carte-appui mt-8 lg:hidden">
          <p id="sommaire-mobile" class="carte-appui-titre">
            Dans ce guide
          </p>
          <div class="sommaire">
            {sommaire.map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
          </div>
        </nav>
      )}

      <div class="guide-corps prose-measure mt-8">
        <Content />
      </div>

      <section aria-labelledby="sources-guide" class="prose-measure mt-10">
        <h2 id="sources-guide" class="titre-section">
          Sources officielles
        </h2>
        <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm">
          {d.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener">
                {s.titre}
              </a>
            </li>
          ))}
        </ol>
      </section>

      <InscriptionNewsletter
        id="nl-guide"
        titre="Recevoir les prochains guides"
        class="prose-measure mt-8"
      />

      {autresGuides.length > 0 && (
        <section aria-labelledby="autres-guides" class="prose-measure mt-10">
          <h2 id="autres-guides" class="titre-section">
            À lire ensuite
          </h2>
          <ul class="liste-filets mt-2">
            {autresGuides.map((g) => (
              <li>
                <a href={`/guides/${g.id}`} class="font-semibold">
                  {insecables(g.data.title)}
                </a>
                <p class="mt-1 text-sm text-ink-soft">{g.data.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <EspacePublicitaire emplacement="guides" class="prose-measure mt-10" />
    </article>

    <aside class="colonne-appui" aria-label="Sommaire et accès rapides">
      {sommaire.length > 2 && (
        <nav class="carte-appui hidden lg:block" aria-labelledby="sommaire-guide">
          <p id="sommaire-guide" class="carte-appui-titre">
            Dans ce guide
          </p>
          <div class="sommaire">
            {sommaire.map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
          </div>
        </nav>
      )}

      <div class="carte-appui">
        <p class="carte-appui-titre">Passer à l'action</p>
        <p class="mt-2 text-sm text-ink-soft">
          Cinq questions pour le logiciel adapté à votre métier, deux pour vos échéances.
        </p>
        <p class="mt-3 text-sm">
          <a href="/outils/quiz" class="lien-fleche">
            Faire le quiz
          </a>
        </p>
        <p class="mt-3 text-sm">
          <a href="/outils/echeance">Simuler mon échéance</a>
        </p>
      </div>

      <div class="carte-appui">
        <p class="carte-appui-titre">Vérifier une facture</p>
        <p class="mt-2 text-sm text-ink-soft">
          Les mentions obligatoires manquantes, chacune avec sa source officielle.
        </p>
        <p class="mt-3 text-sm">
          <a href="/outils/verificateur-facture">Ouvrir le vérificateur</a>
        </p>
      </div>
    </aside>
  </div>
</Base>

<style>
  /* Typographie des corps de guide (MDX) */
  /* Les h2 du corps ouvrent une section comme les titres du gabarit : serif,
     sous un filet d'encre. */
  .guide-corps :global(h2) {
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-ink);
    padding-top: 0.6rem;
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.625rem);
  }
  .guide-corps :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.125rem;
  }
  .guide-corps :global(p) {
    margin-top: 0.75rem;
  }
  .guide-corps :global(ul),
  .guide-corps :global(ol) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .guide-corps :global(ol) {
    list-style: decimal;
  }
  .guide-corps :global(li) {
    margin-top: 0.5rem;
    line-height: 1.55;
  }
  .guide-corps :global(li::marker) {
    color: var(--color-accent);
  }
  /* Un tableau markdown dépasse la largeur de lecture : il défile seul plutôt
     que de pousser toute la page sous 400 px. */
  .guide-corps :global(table) {
    display: block;
    overflow-x: auto;
    margin-top: 0.75rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .guide-corps :global(th),
  .guide-corps :global(td) {
    padding: 0.5rem 0.75rem 0.5rem 0;
    text-align: left;
    vertical-align: top;
  }
  .guide-corps :global(blockquote) {
    margin-top: 1rem;
    border-left: 2px solid var(--color-ink);
    padding-left: 1rem;
    color: var(--color-ink-soft);
  }
</style>
