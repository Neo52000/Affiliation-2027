---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE } from '../../config';
import { formatDateFr } from '../../lib/dates';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { entry: g } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const site = (Astro.site ?? new URL(SITE.url)).toString().replace(/\/+$/, '');
// JSON-LD Article sur les guides (section 9).
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  inLanguage: 'fr-FR',
  dateModified: d.date_maj,
  mainEntityOfPage: `${site}/guides/${entry.id}`,
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@id': `${site}/#organisation` },
};
---

<Base title={d.title} description={d.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
  <Breadcrumb items={[{ label: 'Guides' }, { label: d.title }]} />

  <article class="prose-measure mt-4">
    <h1 class="text-3xl font-bold">{d.title}</h1>
    <p class="mt-2 text-sm text-ink-soft">
      Mis à jour le {formatDateFr(d.date_maj)}
      {SITE.expertRelecteur ? ` · Relu par ${SITE.expertRelecteur}` : ''}
    </p>

    <div class="guide-corps mt-6">
      <Content />
    </div>

    <section aria-labelledby="sources-guide" class="mt-10">
      <h2 id="sources-guide" class="text-2xl font-bold">
        Sources officielles
      </h2>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm">
        {d.sources.map((s) => (
          <li>
            <a href={s.url} rel="noopener">
              {s.titre}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-8 rounded-md border border-border bg-paper-soft p-4 text-sm">
      Information générale : ce guide ne remplace pas l'avis de votre expert-comptable.
    </p>
  </article>
</Base>

<style>
  /* Typographie des corps de guide (MDX) */
  .guide-corps :global(h2) {
    margin-top: 2rem;
    font-size: 1.5rem;
    font-weight: 700;
  }
  .guide-corps :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.17rem;
    font-weight: 700;
  }
  .guide-corps :global(p) {
    margin-top: 0.75rem;
  }
  .guide-corps :global(ul),
  .guide-corps :global(ol) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .guide-corps :global(ol) {
    list-style: decimal;
  }
  .guide-corps :global(li) {
    margin-top: 0.375rem;
  }
  .guide-corps :global(table) {
    margin-top: 0.75rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .guide-corps :global(th),
  .guide-corps :global(td) {
    border-bottom: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem 0.5rem 0;
    text-align: left;
  }
</style>
