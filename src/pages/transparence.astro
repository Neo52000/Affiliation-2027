---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { EDITEUR_IDENTIFIE, SITE } from '../config';
import { pageTitle } from '../lib/seo';
import { formatDateFr } from '../lib/dates';
import { jourParis } from '../lib/publicites';
import { affiliationSchema, publicitesSchema } from '../lib/schemas';
import affiliation from '../data/affiliation.json';
import publicites from '../data/publicites.json';

const { liens } = affiliationSchema.parse(affiliation);

// Annonces diffusées à la date du build (le site est reconstruit dans la nuit
// où une campagne commence ou se termine). Le schéma interdit deux campagnes
// concurrentes : toute campagne active et en cours est affichée.
const jour = jourParis();
const annoncesDuJour = EDITEUR_IDENTIFIE
  ? publicitesSchema
      .parse(publicites)
      .campagnes.filter((c) => c.active && c.debut <= jour && jour <= c.fin)
      .sort((a, b) => a.annonceur.localeCompare(b.annonceur, 'fr'))
  : [];

// Relation de chaque éditeur comparé avec le site (code de la consommation,
// L111-7 : existence d'une relation contractuelle ou d'une rémunération).
// « Partenariat » = un lien affilié est enregistré, même suspendu.
const outils = (await getCollection('outils'))
  .map((o) => {
    const lien = liens[o.data.slug];
    return {
      nom: o.data.nom,
      partenariat: lien?.url ? `Oui${lien.reseau ? ` (${lien.reseau})` : ''}` : 'Non',
      lienPublie: lien?.actif && lien.url ? 'Oui' : 'Non',
      annonce: annoncesDuJour.some((c) => c.outil === o.data.slug) ? 'Oui' : 'Non',
    };
  })
  .sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));
const sansLien = outils.filter((o) => o.lienPublie === 'Non').length;

// Ce que l'argent ne change pas : l'engagement central du site, énoncé en trois
// points vérifiables plutôt qu'en déclaration d'intention.
const GARANTIES: { titre: string; texte: string }[] = [
  {
    titre: 'Ni l’ordre, ni les notes',
    texte:
      'La méthode de notation est publique. Ni les commissions ni les achats d’espace publicitaire n’y figurent ou n’entrent dans le quiz.',
  },
  {
    titre: 'Aucun montant affiché',
    texte:
      'Les montants de commission ou d’achat d’espace ne sont jamais affichés ni pris en compte dans un classement.',
  },
  {
    titre: 'Publicité signalée, contenu jamais vendu',
    texte:
      'Aucun article sponsorisé, aucun faux avis, aucun échange de lien. Une publicité est toujours signalée et séparée.',
  },
];
---

<Base
  title={pageTitle('Comment le site gagne de l’argent', SITE.name)}
  description="Transparence : liens affiliés et publicités signalés, sans influence sur les classements, méthode de notation publique."
>
  <Breadcrumb items={[{ label: 'Transparence' }]} />

  <div class="layout-article mt-4">
    <div>
      <p class="surtitre">Confiance</p>
      <h1 class="titre-page mt-3">Comment ce site gagne de l'argent</h1>

      <p class="chapo mt-5">
        Ce site est financé par l'affiliation : si vous ouvrez un compte chez certains éditeurs en
        passant par nos liens, nous pouvons percevoir une commission. Il peut aussi vendre des
        espaces publicitaires en direct.
      </p>

      <section aria-labelledby="ce-que-vous-voyez" class="mt-12">
        <h2 id="ce-que-vous-voyez" class="titre-section">
          Ce que vous voyez sur le site
        </h2>
        <ul class="liste-filets mt-2">
          <li>
            Chaque lien affilié est signalé par la mention « lien affilié » à côté du bouton, et la
            page qui en contient affiche un bandeau en haut.
          </li>
          <li>
            Les liens affiliés passent par des adresses <code>/go/…</code>, exclues des moteurs de
            recherche.
          </li>
          <li>
            Sans lien affilié publié pour un éditeur, le bouton pointe directement vers son site
            officiel, sans mention.
            {sansLien > 0 &&
              ` C'est le cas aujourd'hui pour ${sansLien === outils.length ? 'tous les logiciels du site' : 'une partie des logiciels'}.`}
          </li>
        </ul>
      </section>

      <section aria-labelledby="selection" class="mt-12">
        <h2 id="selection" class="titre-section">
          Les logiciels comparés
        </h2>
        <p class="prose-measure mt-3">
          Les {outils.length} logiciels du comparatif ont été retenus, au lancement du site, parmi
          des éditeurs qui proposent un programme d'affiliation. La sélection n'est donc pas
          exhaustive : la{' '}
          <a href="/plateformes-agreees">liste officielle des plateformes agréées</a> en compte bien
          d'autres. Une fois un logiciel retenu, sa note et son rang ne dépendent que de la méthode
          publique.
        </p>
        <div
          class="table-scroll mt-4"
          role="region"
          aria-label="Relation de chaque éditeur avec le site"
          tabindex="0"
        >
          <table class="w-full border-collapse text-sm">
            <caption class="sr-only">Relation de chaque éditeur comparé avec le site</caption>
            <thead>
              <tr>
                <th scope="col" class="py-2 pr-3">
                  Logiciel
                </th>
                <th scope="col" class="py-2 pr-3">
                  Partenariat d'affiliation
                </th>
                <th scope="col" class="py-2 pr-3">
                  Lien affilié publié
                </th>
                <th scope="col" class="py-2">
                  Annonce en cours
                </th>
              </tr>
            </thead>
            <tbody>
              {outils.map((o) => (
                <tr>
                  <th scope="row" class="py-2 pr-3 font-normal">
                    {o.nom}
                  </th>
                  <td class="py-2 pr-3">{o.partenariat}</td>
                  <td class="py-2 pr-3">{o.lienPublie}</td>
                  <td class="py-2">{o.annonce}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-sm text-ink-soft">
          État au {formatDateFr(jour)}. Aucun montant de commission ou d'achat d'espace n'est
          publié.
        </p>
      </section>

      <section aria-labelledby="ce-que-ca-ne-change-pas" class="mt-12">
        <h2 id="ce-que-ca-ne-change-pas" class="titre-section">
          Ce que l'argent ne change pas
        </h2>
        <ul class="liste-filets prose-measure mt-2">
          {GARANTIES.map((g) => (
            <li>
              <p class="font-semibold">{g.titre}</p>
              <p class="mt-1 text-sm text-ink-soft">{g.texte}</p>
            </li>
          ))}
        </ul>
        <p class="prose-measure mt-4 text-sm">
          La <a href="/methode">méthode de notation</a> détaille la pondération de chaque critère,
          et aucune ligne n'y porte sur une commission ou une publicité.
        </p>
      </section>

      <section aria-labelledby="publicite" class="mt-12">
        <h2 id="publicite" class="titre-section">
          La publicité
        </h2>
        <ul class="liste-filets mt-2">
          <li>
            Le site peut vendre des espaces publicitaires en direct, sans régie, toujours en fin de
            page : sur l'accueil, à la fin des guides et sur les pages famille de métiers. Voir l'
            <a href="/publicite">offre aux annonceurs</a>.
          </li>
          <li>
            Chaque annonce porte la mention « Publicité » et le nom de l'annonceur, avant son
            contenu. Elle n'apparaît jamais sur les fiches métier, les fiches logiciel, les
            comparatifs, les outils ni la méthode, et jamais à l'intérieur d'une recommandation.
          </li>
          <li>
            Un annonceur peut être l'un des éditeurs comparés : son annonce le signale, n'est
            diffusée que sur l'accueil ou les guides, et ne change ni ses notes, ni son rang, ni les
            recommandations, calculés sans aucune donnée publicitaire.
          </li>
          <li>
            Aucune annonce ne dépose de cookie ni de traceur : texte et image sont servis par ce
            site. Le lien mène directement chez l'annonceur, avec des paramètres qui lui indiquent
            seulement que la visite vient de ce site.
          </li>
        </ul>
        {annoncesDuJour.length === 0 ? (
          <p class="mt-3">Aucune annonce n'est diffusée à la date du {formatDateFr(jour)}.</p>
        ) : (
          <>
            <p class="mt-3">Annonces diffusées à la date du {formatDateFr(jour)} :</p>
            <ul class="mt-2 list-disc pl-5">
              {annoncesDuJour.map((c) => (
                <li>
                  {c.annonceur} ({c.annonceur_legal}), jusqu'au {formatDateFr(c.fin)}
                </li>
              ))}
            </ul>
          </>
        )}
      </section>

      <section aria-labelledby="vos-donnees" class="mt-12">
        <h2 id="vos-donnees" class="titre-section">
          Vos données
        </h2>
        <p class="mt-3">
          Pas de cookie soumis à consentement, pas de traceur publicitaire. Les deux inscriptions
          par email (rappel d'échéance, newsletter) sont en double opt-in ; le détail figure dans la{' '}
          <a href="/confidentialite">politique de confidentialité</a>.
        </p>
      </section>
    </div>

    <aside class="colonne-appui" aria-label="Pour aller plus loin">
      <div class="carte-appui">
        <p class="carte-appui-titre">Vérifier par vous-même</p>
        <p class="mt-2 text-sm text-ink-soft">
          La méthode est publique, critère par critère, avec le poids de chacun.
        </p>
        <p class="mt-3 text-sm">
          <a href="/methode">Lire la méthode de notation</a>
        </p>
      </div>

      <div class="carte-appui">
        <p class="carte-appui-titre">Qui écrit ce site</p>
        <p class="mt-2 text-sm text-ink-soft">
          Qui nous sommes, ce que nous testons, et ce que nous ne publions pas.
        </p>
        <p class="mt-3 text-sm">
          <a href="/a-propos">À propos</a>
        </p>
      </div>

      <div class="carte-appui">
        <p class="carte-appui-titre">Vos données</p>
        <p class="mt-2 text-sm text-ink-soft">Aucun cookie soumis à consentement sur ce site.</p>
        <p class="mt-3 text-sm">
          <a href="/confidentialite">Politique de confidentialité</a>
        </p>
      </div>
    </aside>
  </div>
</Base>
