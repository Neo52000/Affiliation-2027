---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ListeFamilles from '../components/ListeFamilles.astro';
import { SITE } from '../config';
import { pageTitle } from '../lib/seo';
import { FAMILLE_LABELS, type Famille } from '../lib/familles';
import hubs from '../data/hubs.json';

// Une page d'erreur qui ne propose que « retour à l'accueil » est un cul-de-sac.
// Les familles réellement publiées sont listées : le lecteur repart de là.
const metiers = await getCollection('metiers');
const familles = (Object.keys(FAMILLE_LABELS) as Famille[])
  .map((f) => ({
    famille: f,
    label: FAMILLE_LABELS[f],
    nb: metiers.filter((m) => m.data.famille === f).length,
    hub: f in hubs,
  }))
  .filter((f) => f.hub && f.nb > 0);
---

<Base
  title={pageTitle('Page introuvable', SITE.name)}
  description="Cette page n'existe pas ou a été déplacée."
  noindex
>
  <div class="prose-measure">
    <p class="surtitre">Erreur 404</p>
    <h1 class="titre-une mt-3">Cette page n'existe pas</h1>
    <p class="chapo mt-4">Elle a peut-être été déplacée, ou l'adresse comporte une erreur.</p>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a href="/outils/quiz" class="btn-cta">
        Trouver mon logiciel
      </a>
      <a href="/" class="btn-ghost">
        Retourner à l'accueil
      </a>
    </div>
  </div>

  {familles.length > 0 && (
    <section aria-labelledby="familles-404" class="mt-12">
      <h2 id="familles-404" class="titre-section">
        Les métiers documentés
      </h2>
      <ListeFamilles familles={familles} class="mt-2 max-w-2xl" />
    </section>
  )}

  <section aria-labelledby="outils-404" class="mt-12">
    <h2 id="outils-404" class="titre-section">
      Les outils du site
    </h2>
    <ul class="liste-filets mt-2 max-w-2xl">
      <li>
        <p class="font-semibold">
          <a href="/outils/quiz">Quiz</a>
        </p>
        <p class="mt-1 text-sm text-ink-soft">
          Cinq questions, un logiciel adapté à votre métier et deux alternatives.
        </p>
      </li>
      <li>
        <p class="font-semibold">
          <a href="/outils/echeance">Simulateur d'échéance</a>
        </p>
        <p class="mt-1 text-sm text-ink-soft">
          Ce qui s'applique à votre entreprise, et à quelle date.
        </p>
      </li>
      <li>
        <p class="font-semibold">
          <a href="/outils/verificateur-facture">Vérificateur de facture</a>
        </p>
        <p class="mt-1 text-sm text-ink-soft">
          Les mentions obligatoires manquantes, chacune avec sa source.
        </p>
      </li>
    </ul>
  </section>
</Base>
