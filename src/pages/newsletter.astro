---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import InscriptionNewsletter from '../components/InscriptionNewsletter.astro';
import { SITE } from '../config';
import { pageTitle } from '../lib/seo';
---

<Base
  title={pageTitle('Newsletter facturation électronique', SITE.name)}
  description="Recevez par email les évolutions de la facturation électronique et les nouveaux guides du site. Double opt-in, désinscription en un clic."
>
  <Breadcrumb items={[{ label: 'Newsletter' }]} />
  <div class="prose-measure mt-4">
    <p class="surtitre">Newsletter</p>
    <h1 class="titre-page mt-3">La newsletter</h1>
    <p class="mt-3">
      Les évolutions de la réforme de la facturation électronique, et les nouveaux guides et
      comparatifs du site, dans votre boîte mail : au plus une fois par mois, sans publicité ni lien
      affilié.
    </p>
    <ul class="liste-filets mt-2">
      <li>
        Inscription confirmée par email (double opt-in) : personne ne peut vous inscrire à votre
        place.
      </li>
      <li>Désinscription en un clic, par le lien présent dans chaque envoi.</li>
      <li>Votre adresse n'est ni vendue ni transmise à un annonceur.</li>
    </ul>
    <InscriptionNewsletter id="nl-page" siFerme="annoncer" class="mt-8" />
  </div>
</Base>
