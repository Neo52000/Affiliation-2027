---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../config';
import { pageTitle } from '../lib/seo';
import echeances from '../data/echeances.json';

// Identité de l'éditeur : EDITEUR_LEGAL non renseigné (TODO.md #3). La page
// reste hors index tant que les placeholders sont présents.
const placeholders = SITE.name.startsWith('TODO_');

// Périmètre de la réforme : celui d'echeances.json, avec sa source officielle.
const reception = echeances.echeances.find((e) => e.id === 'reception-toutes-entreprises');
if (!reception?.sources[0]) throw new Error('echeances.json : réception sans source');
const sourceReforme = reception.sources[0];
---

<Base
  title={pageTitle('À propos', SITE.name)}
  description="Qui édite ce site, pourquoi il existe et comment il travaille : comparateur indépendant de logiciels de facturation électronique, métier par métier."
  noindex={placeholders}
>
  <Breadcrumb items={[{ label: 'À propos' }]} />

  <div class="layout-article mt-4">
    <article>
      <p class="surtitre">Confiance</p>
      <h1 class="titre-page mt-3">À propos de ce site</h1>

      <h2 class="titre-section mt-10">Pourquoi ce site existe</h2>
      <p class="prose-measure mt-3">
        La facturation électronique s'impose à toutes les entreprises établies en France et
        assujetties à la TVA, y compris en franchise en base (
        <a href={sourceReforme} rel="noopener">
          impots.gouv.fr
        </a>
        ). Les comparatifs existants classent surtout par statut juridique, rarement par métier,
        alors que c'est le métier qui dicte les besoins : TVA multi-taux d'un plombier, exonération
        d'un infirmier libéral, autofacturation d'un VTC.
      </p>
      <p class="prose-measure mt-3">
        Ce site prend l'angle inverse : une page par métier, des spécificités vérifiées sur sources
        officielles, et des recommandations fondées sur des faits. La{' '}
        <a href="/methode">méthode de notation</a> est publique, et le{' '}
        <a href="/transparence">financement du site</a> est détaillé.
      </p>

      <h2 class="titre-section mt-10">Qui édite ce site</h2>
      {placeholders ? (
        <p class="prose-measure mt-3">
          L'identité complète de l'éditeur (raison sociale, SIRET, directeur de publication) est en
          cours de publication et figurera ici et dans les{' '}
          <a href="/mentions-legales">mentions légales</a>.
        </p>
      ) : (
        <p class="prose-measure mt-3">
          Édité par {SITE.name}. Contact : {SITE.emailContact}.
        </p>
      )}

      <h2 class="titre-section mt-10">Relecture</h2>
      <p class="prose-measure mt-3">
        {SITE.expertRelecteur
          ? `Les contenus réglementaires sont relus par ${SITE.expertRelecteur}.`
          : "Un expert-comptable relecteur rejoindra le site ; en attendant, chaque affirmation réglementaire est adossée à une source officielle citée en bas de page, et aucun contenu n'affiche de relecteur fictif."}
      </p>
    </article>

    <aside class="colonne-appui" aria-label="Pour aller plus loin">
      <div class="carte-appui">
        <p class="carte-appui-titre">Notre méthode</p>
        <p class="mt-2 text-sm text-ink-soft">
          Les critères de classement, leur poids, et pourquoi aucune note n'est publiée avant notre
          test.
        </p>
        <p class="mt-3 text-sm">
          <a href="/methode">Lire la méthode</a>
        </p>
      </div>

      <div class="carte-appui">
        <p class="carte-appui-titre">Notre financement</p>
        <p class="mt-2 text-sm text-ink-soft">
          Comment le site gagne de l'argent, et ce que cela ne change pas.
        </p>
        <p class="mt-3 text-sm">
          <a href="/transparence">Lire la page transparence</a>
        </p>
      </div>

      <div class="carte-appui">
        <p class="carte-appui-titre">Commencer</p>
        <p class="mt-2 text-sm text-ink-soft">
          Cinq questions pour le logiciel adapté à votre métier.
        </p>
        <p class="mt-3 text-sm">
          <a href="/outils/quiz" class="lien-fleche">
            Faire le quiz
          </a>
        </p>
      </div>
    </aside>
  </div>
</Base>
