---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Picto from '../../components/Picto.astro';
import MetierPicker from '../../components/islands/MetierPicker.tsx';
import EspacePublicitaire from '../../components/EspacePublicitaire.astro';
import { FAMILLE_FORMES, FAMILLE_LABELS, estElide, type Famille } from '../../lib/familles';
import { outilsRetenus } from '../../lib/hub';
import { pointsFamillesSchema } from '../../lib/schemas';
import { familleTitle, pageTitle } from '../../lib/seo';
import { formatDateFr } from '../../lib/dates';
import { SITE } from '../../config';
import echeances from '../../data/echeances.json';

export async function getStaticPaths() {
  // Un hub n'est publié que lorsque son introduction est rédigée (src/data/hubs.json)
  // ET qu'au moins une page métier de la famille existe.
  const { default: intros } = await import('../../data/hubs.json');
  const metiers = await getCollection('metiers');
  return Object.entries(intros as Record<string, string[]>)
    .filter(([f]) => metiers.some((m) => m.data.famille === f))
    .map(([famille, intro]) => ({ params: { famille }, props: { intro } }));
}

const { intro } = Astro.props;
const famille = Astro.params.famille as Famille;
const label = FAMILLE_LABELS[famille];
const formes = FAMILLE_FORMES[famille];
// « pour le » suivi d'un espace, « pour l’ » collé au nom : une seule unité animée,
// pour que le formatage du gabarit ne puisse jamais insérer d'espace après l’élision.
const debutTitre = estElide(formes.pour) ? formes.pour : `${formes.pour} `;
const tous = await getCollection('metiers');
const metiers = tous
  .filter((m) => m.data.famille === famille)
  .sort((a, b) => a.data.nom.localeCompare(b.data.nom, 'fr'));
const outils = await getCollection('outils');
const nomsOutils = Object.fromEntries(outils.map((o) => [o.data.slug, o.data.nom]));
const nomsMetiers = Object.fromEntries(tous.map((m) => [m.data.slug, m.data.nom]));

// La spécification vise 10 métiers par famille : la phrase d'attente ne
// s'affiche que tant que la famille est incomplète, jamais par habitude.
const CIBLE_PAR_FAMILLE = 10;
const familleComplete = metiers.length >= CIBLE_PAR_FAMILLE;

const LIBELLE_CLIENTS: Record<string, string> = {
  B2B: 'Clients professionnels',
  B2C: 'Clients particuliers',
  mixte: 'Pros et particuliers',
};

// Sélecteur : la recommandation de chaque fiche, dans son ordre publié.
const choixMetiers = metiers.map((m) => ({
  slug: m.data.slug,
  nom: m.data.nom,
  outils: m.data.outils_recommandes.flatMap((o) => {
    const nom = nomsOutils[o.slug];
    return nom ? [{ slug: o.slug, nom }] : [];
  }),
}));

const retenus = outilsRetenus(
  metiers.map((m) => m.data),
  nomsOutils,
);

// Points de facturation communs à la famille : affichés seulement s'ils sont
// rédigés et sourcés (src/data/points-familles.json, validé ici au build).
const fichiersPoints = import.meta.glob<unknown>('../../data/points-familles.json', {
  import: 'default',
  eager: true,
});
const donneesPoints = Object.values(fichiersPoints)[0];
const pointsFamilles = donneesPoints ? pointsFamillesSchema.parse(donneesPoints) : null;
const points = pointsFamilles?.familles[famille] ?? [];

// Les autres familles, pour qu'un lecteur arrivé sur le mauvais hub reparte
// d'ici plutôt que de la page d'accueil.
const autresFamilles = (Object.keys(FAMILLE_LABELS) as Famille[])
  .filter((f) => f !== famille && tous.some((m) => m.data.famille === f))
  .map((f) => ({ famille: f, label: FAMILLE_LABELS[f] }));

// L'introduction du hub décrit la réforme : elle renvoie à la source officielle,
// comme les pages métier (règle : toute affirmation réglementaire est sourcée).
const reception = echeances.echeances.find((e) => e.id === 'reception-toutes-entreprises');
if (!reception) throw new Error('echeances.json : échéance de réception manquante');
---

<Base
  title={pageTitle(familleTitle(label), SITE.name)}
  description={`Facturation électronique pour les métiers de la famille ${label.toLowerCase()} : obligations communes, spécificités et guides par métier.`}
>
  <Breadcrumb items={[{ label: 'Métiers' }, { label }]} />

  <div class="layout-article mt-4">
    <div>
      <div class="hero flex items-center gap-4 pt-2">
        <span class="picto-carre shrink-0">
          <Picto nom={famille} taille={26} />
        </span>
        <div>
          <h1 class="m-mots text-3xl font-extrabold sm:text-4xl">
            <span class="m-word">Facturation</span> <span class="m-word">électronique</span>{' '}
            <span class="m-word">
              {debutTitre}
              <span class="text-gradient m-reflet">{formes.objet}</span>
            </span>
          </h1>
          <p class="mt-1 text-sm text-ink-soft">
            {metiers.length} métier{metiers.length > 1 ? 's' : ''} documenté
            {metiers.length > 1 ? 's' : ''} · obligations communes et spécificités de chacun
          </p>
        </div>
      </div>

      <section class="prose-measure mt-6 space-y-3">
        {intro.map((p) => (
          <p>{p}</p>
        ))}
      </section>

      <MetierPicker client:idle metiers={choixMetiers} />

      {points.length > 0 && pointsFamilles && (
        <section aria-labelledby="points-famille" class="mt-10">
          <h2 id="points-famille" class="titre-section text-2xl font-bold">
            {points.length} points de facturation propres {formes.a}
          </h2>
          <ol class="mt-4 grid gap-4 sm:grid-cols-2">
            {points.map((p, i) => (
              <li class="m-lift reveal rounded-lg border border-border bg-paper p-4">
                <span class="picto-carre m-pop-icon text-lg font-extrabold">{i + 1}</span>
                <h3 class="mt-3 font-bold">{p.titre}</h3>
                <p class="mt-1 text-sm">{p.texte}</p>
                <p class="mt-2 text-sm text-ink-soft">
                  Concerne notamment :{' '}
                  {p.metiers_concernes.map((slug, j) => (
                    <>
                      {j > 0 && ', '}
                      <a href={`/facturation-electronique/${slug}`}>{nomsMetiers[slug]}</a>
                    </>
                  ))}
                </p>
                <p class="mt-1 text-sm text-ink-soft">
                  Source :{' '}
                  {p.sources.map((s, j) => (
                    <>
                      {j > 0 && ' · '}
                      <a href={s.url} rel="noopener">
                        {s.titre}
                      </a>
                    </>
                  ))}
                </p>
              </li>
            ))}
          </ol>
          <p class="mt-2 text-xs text-ink-soft">
            Points relevés le {formatDateFr(pointsFamilles.date_releve)} sur les sources citées.
            Chaque fiche métier détaille ses propres règles.
          </p>
        </section>
      )}

      <section aria-labelledby="liste-metiers" class="mt-10">
        <h2 id="liste-metiers" class="titre-section text-2xl font-bold">
          Choisir votre métier
        </h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {metiers.map((m) => (
            <li class="carte-metier card-reco">
              <p class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <a
                  href={`/facturation-electronique/${m.data.slug}`}
                  class="text-base font-bold no-underline"
                >
                  {m.data.nom}
                </a>
                <span class="text-xs text-ink-soft">
                  {LIBELLE_CLIENTS[m.data.clients_types] ?? m.data.clients_types}
                </span>
              </p>
              {m.data.besoins_prioritaires[0] && (
                <p class="ligne-2 mt-2 text-sm text-ink-soft">{m.data.besoins_prioritaires[0]}</p>
              )}
            </li>
          ))}
        </ul>
        {!familleComplete && (
          <p class="prose-measure mt-4 text-sm text-ink-soft">
            D'autres métiers de cette famille seront ajoutés progressivement.
          </p>
        )}
      </section>

      {retenus.length > 0 && (
        <section aria-labelledby="outils-famille" class="mt-10">
          <h2 id="outils-famille" class="titre-section text-2xl font-bold">
            Les outils retenus pour ces métiers
          </h2>
          <p class="prose-measure mt-2 text-sm text-ink-soft">
            Chaque fiche métier retient trois outils sur des faits vérifiés, jamais sur les
            commissions. Ici, le nombre de fiches qui citent chacun ; à égalité, l'ordre
            alphabétique.
          </p>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {retenus.map((o) => (
              <li class="m-lift reveal flex items-center gap-3 rounded-lg border border-border bg-paper p-3">
                <span class="duel-monogramme m-pop-icon shrink-0" aria-hidden="true">
                  {o.nom.slice(0, 1)}
                </span>
                <span>
                  <a href={`/logiciels/${o.slug}`} class="lien-carte font-bold">
                    {o.nom}
                  </a>
                  <span class="block text-sm text-ink-soft">
                    Retenu sur {o.fiches} fiche{o.fiches > 1 ? 's' : ''} sur {metiers.length}
                  </span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section aria-labelledby="quiz-famille" class="m-panneau reveal mt-10 p-6 sm:p-8">
        <h2 id="quiz-famille" class="text-2xl font-bold">
          Pas sûr de votre choix ?
        </h2>
        <p class="prose-measure mt-2">
          Cinq questions sur votre activité suffisent pour une recommandation fondée sur des faits
          vérifiés.
        </p>
        <p class="mt-5">
          <a href="/outils/quiz" class="btn-clair">
            Faire le quiz
          </a>
        </p>
      </section>

      <EspacePublicitaire emplacement="familles" famille={famille} class="mt-10" />

      {autresFamilles.length > 0 && (
        <section aria-labelledby="autres-familles" class="mt-10">
          <h2 id="autres-familles" class="titre-section text-2xl font-bold">
            Votre métier n'est pas dans cette famille ?
          </h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {autresFamilles.map((f) => (
              <li>
                <a href={`/metiers/${f.famille}`} class="puce-famille">
                  <Picto nom={f.famille} taille={18} />
                  {f.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section
        aria-labelledby="sources-hub"
        class="prose-measure mt-10 border-t border-border pt-4"
      >
        <h2 id="sources-hub" class="text-lg font-bold">
          Source
        </h2>
        <p class="mt-2 text-sm">
          <a href={reception.sources[0]} rel="noopener">
            Calendrier officiel de la réforme (impots.gouv.fr)
          </a>
        </p>
        <p class="mt-2 text-sm text-ink-soft">
          Données relevées le {formatDateFr(echeances.date_releve)}. Information générale : ne
          remplace pas l'avis de votre expert-comptable.
        </p>
      </section>
    </div>

    <aside class="colonne-appui" aria-label="Accès rapides">
      <div class="carte-appui card-top">
        <p class="carte-appui-titre">Trouver votre outil</p>
        <p class="mt-2 text-sm text-ink-soft">
          Cinq questions, une recommandation fondée sur des faits vérifiés — jamais sur les
          commissions.
        </p>
        <p class="mt-3">
          <a href="/outils/quiz" class="btn-cta">
            Faire le quiz
          </a>
        </p>
      </div>

      <div class="carte-appui">
        <p class="carte-appui-titre">Votre échéance</p>
        <p class="mt-2 text-sm text-ink-soft">
          Deux questions pour savoir ce qui s'applique à vous, et quand.
        </p>
        <p class="mt-3 text-sm">
          <a href="/outils/echeance">Simuler mon échéance</a>
        </p>
      </div>

      <div class="carte-appui">
        <p class="carte-appui-titre">Notre méthode</p>
        <p class="mt-2 text-sm text-ink-soft">
          Comment les outils sont classés, et pourquoi aucune note n'est encore publiée.
        </p>
        <p class="mt-3 text-sm">
          <a href="/methode">Lire la méthode</a>
        </p>
      </div>
    </aside>
  </div>
</Base>
