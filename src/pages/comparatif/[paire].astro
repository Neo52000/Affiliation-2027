---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import ComparatifCourt from '../../components/ComparatifCourt.astro';
import BandeauTransparence from '../../components/BandeauTransparence.astro';
import { toutesLesPaires } from '../../lib/comparatifs';
import { formatDateFr } from '../../lib/dates';
import { insecables } from '../../lib/presentation';
import { de } from '../../lib/typographie';
import { pageTitle } from '../../lib/seo';
import { SITE } from '../../config';

export async function getStaticPaths() {
  // Toutes les paires des 6 outils principaux (C(6,2) = 15), dans l'ordre de la
  // spécification — stable pour les URLs (dont le pilote tiime-vs-qonto).
  const outils = await getCollection('outils');
  const paths = [];
  for (const [sa, sb] of toutesLesPaires()) {
    const oa = outils.find((o) => o.data.slug === sa);
    const ob = outils.find((o) => o.data.slug === sb);
    if (oa && ob) paths.push({ params: { paire: `${sa}-vs-${sb}` }, props: { oa, ob } });
  }
  return paths;
}

const { oa, ob } = Astro.props;
const a = oa.data;
const b = ob.data;
const dateMaj = a.date_maj > b.date_maj ? a.date_maj : b.date_maj;

// Verdicts par profil, fondés uniquement sur la cible et le périmètre vérifiés.
const profils = [
  {
    profil: 'Vous cherchez d’abord un compte professionnel',
    verdict: [a, b].filter((o) => o.fonctionnalites.compte_pro === true),
  },
  {
    profil: 'Vous voulez facturation et comptabilité au même endroit',
    verdict: [a, b].filter((o) => o.fonctionnalites.compta === true),
  },
  {
    profil: 'Vous êtes indépendant ou micro-entrepreneur',
    verdict: [a, b].filter((o) => o.cible.some((c) => /indépendant|micro|freelance/i.test(c))),
  },
  {
    profil: 'Vous dirigez une PME',
    verdict: [a, b].filter((o) => o.cible.some((c) => /PME/i.test(c))),
  },
];

// Introduction tirée des données : le statut d'agrément de chacun, jamais écrit
// à la main (il change avec le registre).
const agrees = [a, b].filter((o) => o.est_plateforme_agreee.valeur);
const sourceRegistre = agrees.find((o) => o.est_plateforme_agreee.source)?.est_plateforme_agreee
  .source;
const phraseAgrement =
  agrees.length === 2
    ? `${a.nom} et ${b.nom} figurent tous deux au registre des plateformes agréées de l’administration fiscale.`
    : agrees.length === 1
      ? `${agrees[0]!.nom} figure au registre des plateformes agréées de l’administration fiscale ; ${
          (agrees[0] === a ? b : a).nom
        } n’est pas lui-même une plateforme agréée.`
      : `Ni ${a.nom} ni ${b.nom} n’est lui-même une plateforme agréée : vos factures transitent par la plateforme d’un tiers.`;
---

<Base
  title={pageTitle(`${a.nom} ou ${b.nom} : que choisir ?`, SITE.name)}
  description={`${a.nom} contre ${b.nom} pour la facturation électronique : statut de plateforme agréée, périmètre et cible, comparés sur des données vérifiées et datées.`}
>
  <BandeauTransparence outils={[a.slug, b.slug]} />
  <Breadcrumb items={[{ label: 'Comparatifs' }, { label: `${a.nom} ou ${b.nom}` }]} />

  <article class="mt-4">
    <p class="surtitre">Comparatif</p>
    <h1 class="titre-page mt-3">{insecables(`${a.nom} ou ${b.nom} ?`)}</h1>
    <p class="mt-3 text-sm text-ink-soft">Mis à jour le {formatDateFr(dateMaj)}</p>

    <p class="chapo mt-5">
      {insecables(phraseAgrement)}{' '}
      {sourceRegistre && (
        <a href={sourceRegistre} rel="noopener" class="text-base">
          Voir le registre
        </a>
      )}
    </p>
    <p class="prose-measure mt-4">
      La comparaison repose sur des données vérifiées : aucune note avant notre test, aucun prix
      avant son relevé à la source.
    </p>

    <section aria-labelledby="tableau" class="mt-10">
      <h2 id="tableau" class="titre-section">
        Comparaison
      </h2>
      <div class="mt-4 max-w-3xl">
        <ComparatifCourt outils={[a, b]} />
      </div>
    </section>

    <section aria-labelledby="verdict" class="mt-10">
      <h2 id="verdict" class="titre-section">
        Verdict par profil
      </h2>
      <table class="mt-4 w-full max-w-3xl text-sm">
        <caption class="sr-only">
          Le logiciel qui répond à chaque profil, d'après son périmètre vérifié
        </caption>
        <thead>
          <tr>
            <th scope="col" class="py-2 pr-4">
              Votre profil
            </th>
            <th scope="col" class="py-2">
              Verdict
            </th>
          </tr>
        </thead>
        <tbody>
          {profils.map((p) => (
            <tr>
              <th scope="row" class="py-3 pr-4 align-top font-semibold">
                {p.profil}
              </th>
              <td class="py-3 align-top">
                {p.verdict.length === 1
                  ? `${p.verdict[0]!.nom}, d'après le périmètre vérifié à ce jour.`
                  : p.verdict.length === 2
                    ? 'Les deux répondent à ce besoin d’après leur périmètre vérifié.'
                    : 'Aucun des deux ne revendique ce profil : comparez avec les autres logiciels.'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section aria-labelledby="sites" class="mt-10">
      <h2 id="sites" class="titre-section">
        Les sites des éditeurs
      </h2>
      <div class="mt-4 flex flex-wrap gap-4">
        <AffiliateButton
          outil={a.slug}
          urlOfficielle={a.url_officielle}
          label={`Aller sur le site ${de(a.nom)}`}
          emplacement={`comparatif-${a.slug}-vs-${b.slug}-a`}
          variante="secondaire"
        />
        <AffiliateButton
          outil={b.slug}
          urlOfficielle={b.url_officielle}
          label={`Aller sur le site ${de(b.nom)}`}
          emplacement={`comparatif-${a.slug}-vs-${b.slug}-b`}
          variante="secondaire"
        />
      </div>
      <p class="mt-6 text-sm text-ink-soft">
        Fiches détaillées : <a href={`/logiciels/${a.slug}`}>{a.nom}</a> ·{' '}
        <a href={`/logiciels/${b.slug}`}>{b.nom}</a>
      </p>
    </section>
  </article>
</Base>
