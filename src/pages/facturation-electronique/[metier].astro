---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import ExempleFacture from '../../components/ExempleFacture.astro';
import ComparatifCourt from '../../components/ComparatifCourt.astro';
import StatutPlateforme from '../../components/StatutPlateforme.astro';
import BandeauTransparence from '../../components/BandeauTransparence.astro';
import { FAMILLE_LABELS } from '../../lib/familles';
import { formatDateFr } from '../../lib/dates';
import { insecables } from '../../lib/presentation';
import { de } from '../../lib/typographie';
import { jsonLdSur, metierDescription, metierTitle } from '../../lib/seo';
import { paireOrdonnee, urlComparatif } from '../../lib/comparatifs';
import { libelleStatutTest } from '../../lib/statut-test';
import { SITE } from '../../config';
import echeances from '../../data/echeances.json';

export async function getStaticPaths() {
  const metiers = await getCollection('metiers');
  return metiers.map((m) => ({ params: { metier: m.data.slug }, props: { entry: m } }));
}

const { entry } = Astro.props;
const d = entry.data;

const outilsAll = await getCollection('outils');
const recommandes = d.outils_recommandes
  .map((r) => ({
    justification: r.justification,
    outil: outilsAll.find((o) => o.data.slug === r.slug),
  }))
  .filter((r): r is { justification: string; outil: (typeof outilsAll)[number] } =>
    Boolean(r.outil),
  );

// Maillage (section 9) : 2 guides liés depuis chaque page métier.
const guidesUtiles = (await getCollection('guides'))
  .filter((g) =>
    ['calendrier-facturation-electronique', 'passer-facturation-electronique-5-etapes'].includes(
      g.id,
    ),
  )
  .slice(0, 2);

const metiersAll = await getCollection('metiers');
const voisins = [
  ...metiersAll.filter((m) => m.data.famille === d.famille && m.data.slug !== d.slug),
  ...metiersAll.filter((m) => m.data.famille !== d.famille && m.data.slug !== d.slug),
].slice(0, 3);

const reception = echeances.echeances.find((e) => e.id === 'reception-toutes-entreprises');
const emissionTpe = echeances.echeances.find((e) => e.id === 'emission-pme-tpe-micro');
const emissionGe = echeances.echeances.find((e) => e.id === 'emission-ge-eti');
if (!reception || !emissionTpe || !emissionGe) {
  throw new Error('echeances.json : échéances clés manquantes');
}

// Comparaisons deux à deux des outils recommandés : les 15 pages /comparatif/
// existaient sans qu'aucun lien du site n'y mène.
const paires = recommandes.flatMap((a, i) =>
  recommandes.slice(i + 1).map((b) => {
    const [sx] = paireOrdonnee(a.outil.data.slug, b.outil.data.slug);
    const [x, y] =
      sx === a.outil.data.slug ? [a.outil.data, b.outil.data] : [b.outil.data, a.outil.data];
    return { url: urlComparatif(x.slug, y.slug), label: `${x.nom} ou ${y.nom}` };
  }),
);
const familleLabel = FAMILLE_LABELS[d.famille];

// Besoins prioritaires enchaînés dans une phrase : sans leur point final, et
// en minuscule initiale sauf sigle (« TVA », « PDF »).
const enPhrase = (t: string) => {
  const sansPoint = t.trim().replace(/\.+$/, '');
  return /^\p{Lu}\p{Ll}/u.test(sansPoint)
    ? sansPoint.charAt(0).toLowerCase() + sansPoint.slice(1)
    : sansPoint;
};
const besoinsPhrase = d.besoins_prioritaires.slice(0, 3).map(enPhrase).join(' ; ');

// « En bref » : trois phrases ; dates, statuts et complément tirés d'echeances.json,
// périmètres rédigés d'après ses champs « concernes ».
const enVigueur = (statut: string) => statut === 'en_vigueur';
const complementTpe = emissionTpe.complement
  ? ` (${emissionTpe.complement.charAt(0).toLowerCase()}${emissionTpe.complement.slice(1)})`
  : '';
const enBref = [
  `${enVigueur(reception.statut) ? 'Depuis le' : 'À partir du'} ${formatDateFr(reception.date)}, toute entreprise établie en France et assujettie à la TVA, même en franchise en base, ${enVigueur(reception.statut) ? 'doit' : 'devra'} pouvoir recevoir des factures électroniques.`,
  `Pour les TPE, PME et micro-entreprises, l’émission ${enVigueur(emissionTpe.statut) ? 'est obligatoire depuis le' : 'devient obligatoire le'} ${formatDateFr(emissionTpe.date)}${complementTpe}.`,
  'Il vous faut une plateforme agréée et des factures qui portent les mentions obligatoires propres à votre métier.',
].map(insecables);

// Mini-tableau des échéances de la colonne d'appui.
const ECHEANCES_MARGE = [
  { libelle: 'Réception, toutes entreprises', e: reception },
  { libelle: 'Émission, grandes entreprises et ETI', e: emissionGe },
  { libelle: 'Émission, PME, TPE et micro', e: emissionTpe },
];

// Sommaire de la colonne d'appui : les ancres existent déjà dans l'article.
const SOMMAIRE = [
  { id: 'en-bref', label: 'En bref' },
  { id: 'specificites', label: 'Spécificités du métier' },
  { id: 'exemple', label: 'Exemple de facture' },
  { id: 'outils', label: 'Logiciels adaptés' },
  { id: 'checklist', label: 'Mise en conformité' },
  { id: 'faq', label: 'Questions fréquentes' },
  { id: 'sources', label: 'Sources officielles' },
];

// JSON-LD FAQPage (section 9) : questions réellement affichées sur la page.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.reponse },
  })),
};
---

<Base title={metierTitle(d.nom)} description={metierDescription(d.nom)}>
  <script type="application/ld+json" is:inline set:html={jsonLdSur(faqJsonLd)} />
  <BandeauTransparence outils={recommandes.map((r) => r.outil.data.slug)} />

  <Breadcrumb items={[{ label: familleLabel, href: `/metiers/${d.famille}` }, { label: d.nom }]} />

  <div class="layout-article mt-4">
    <article>
      <p class="surtitre">Fiche métier · {familleLabel}</p>
      <h1 class="titre-page mt-3">{d.nom} et facturation électronique</h1>
      <p class="mt-3 text-sm text-ink-soft">
        Mis à jour le {formatDateFr(d.date_maj)}
        {SITE.expertRelecteur && ` · Relu par ${SITE.expertRelecteur}`}
      </p>

      <section aria-labelledby="en-bref" class="en-bref prose-measure mt-6">
        <h2 id="en-bref" class="etiquette">
          En bref
        </h2>
        <ul class="mt-2 space-y-2">
          {enBref.map((phrase) => (
            <li>{phrase}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="specificites" class="mt-10">
        <h2 id="specificites" class="titre-section">
          Les spécificités de facturation du métier
        </h2>
        <ul class="liste-filets prose-measure mt-2">
          {d.specificites_facturation.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
        {d.mentions_obligatoires_specifiques.length > 0 && (
          <>
            <h3 class="mt-6">Mentions propres à votre activité</h3>
            <ul class="liste-filets prose-measure mt-2">
              {d.mentions_obligatoires_specifiques.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
          </>
        )}
      </section>

      <section aria-labelledby="exemple" class="mt-10">
        <h2 id="exemple" class="titre-section">
          Exemple de facture conforme
        </h2>
        <div class="mt-4">
          <ExempleFacture
            intitule={d.exemple_facture.intitule}
            lignes={d.exemple_facture.lignes}
            mentions={d.exemple_facture.mentions_specifiques}
          />
        </div>
      </section>

      <section aria-labelledby="outils" class="mt-10">
        <h2 id="outils" class="titre-section">
          Les logiciels adaptés au métier
        </h2>
        <p class="prose-measure mt-3 text-sm text-ink-soft">
          Choix fondé sur la cible et le périmètre vérifiés de chaque logiciel, selon notre{' '}
          <a href="/methode">méthode</a>. Aucune note n'est publiée avant notre test.
        </p>
        <ol class="mt-4">
          {recommandes.map(({ outil, justification }, i) => (
            <li class="numerote border-t border-border py-5">
              <span class="numero" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                {i === 0 && <p class="etiquette">Notre recommandation</p>}
                <h3 class:list={['text-lg', i === 0 && 'mt-1']}>
                  <a href={`/logiciels/${outil.data.slug}`}>{outil.data.nom}</a>
                  <span class="pill ml-2 align-middle font-normal">
                    {libelleStatutTest(outil.data.statut_test)}
                  </span>
                </h3>
                <p class="prose-measure mt-1">{justification}</p>
                <StatutPlateforme statut={outil.data.est_plateforme_agreee} nom={outil.data.nom} />
                <div class="mt-3">
                  <AffiliateButton
                    outil={outil.data.slug}
                    urlOfficielle={outil.data.url_officielle}
                    label={`Aller sur le site ${de(outil.data.nom)}`}
                    emplacement={`metier-${d.slug}-reco-${i + 1}`}
                    variante={i === 0 ? 'principal' : 'secondaire'}
                  />
                </div>
              </div>
            </li>
          ))}
        </ol>
        <h3 class="mt-8">Comparatif rapide</h3>
        <div class="mt-2">
          <ComparatifCourt outils={recommandes.map((r) => r.outil.data)} />
        </div>
        {paires.length > 0 && (
          <nav aria-label="Comparaisons deux à deux" class="mt-6">
            <h3>Les comparer deux à deux</h3>
            <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-2 text-sm">
              {paires.map((c) => (
                <li>
                  <a href={c.url}>{c.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <p class="mt-6 lg:hidden">
          <a href={`/outils/quiz?metier=${encodeURIComponent(d.slug)}`} class="lien-fleche">
            Affiner avec le quiz
          </a>
        </p>
      </section>

      <section aria-labelledby="checklist" class="mt-10">
        <h2 id="checklist" class="titre-section">
          Se mettre en conformité
        </h2>
        <ol class="prose-measure mt-3 list-decimal space-y-2 pl-5">
          <li>
            Identifiez votre situation : statut ({d.statuts_frequents.join(', ')}), régime de TVA et
            échéance applicable.
          </li>
          <li>Choisissez une plateforme agréée qui couvre vos besoins : {besoinsPhrase}.</li>
          <li>
            Paramétrez vos mentions obligatoires, y compris celles propres à votre activité
            (ci-dessus).
          </li>
          <li>Testez l'émission d'une facture et la réception d'une facture fournisseur.</li>
          <li>Prévenez votre expert-comptable et organisez l'archivage de vos factures.</li>
        </ol>
      </section>

      <section aria-labelledby="faq" class="mt-10">
        <h2 id="faq" class="titre-section">
          Questions fréquentes
        </h2>
        <div class="faq prose-measure mt-2">
          {d.faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p class="pb-4">{f.reponse}</p>
            </details>
          ))}
        </div>
      </section>

      <section aria-labelledby="sources" class="mt-10">
        <h2 id="sources" class="titre-section">
          Sources officielles
        </h2>
        <ol class="prose-measure mt-3 list-decimal space-y-1 pl-5 text-sm">
          {d.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener">
                {s.titre}
              </a>
            </li>
          ))}
          <li>
            <a href={reception.sources[0]} rel="noopener">
              Calendrier de la réforme (impots.gouv.fr)
            </a>
          </li>
        </ol>
        <p class="mt-3 text-sm text-ink-soft">
          Données relevées le {formatDateFr(echeances.date_releve)}.
        </p>
      </section>

      {voisins.length > 0 && (
        <nav aria-labelledby="voisins" class="mt-10">
          <h2 id="voisins" class="titre-section">
            Autres métiers
          </h2>
          <ul class="liste-filets prose-measure mt-2">
            {voisins.map((v) => (
              <li>
                <a href={`/facturation-electronique/${v.data.slug}`}>{v.data.nom}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      {guidesUtiles.length > 0 && (
        <nav aria-labelledby="a-lire" class="mt-10">
          <h2 id="a-lire" class="titre-section">
            À lire ensuite
          </h2>
          <ul class="liste-filets prose-measure mt-2">
            {guidesUtiles.map((g) => (
              <li>
                <a href={`/guides/${g.id}`}>{insecables(g.data.title)}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </article>

    <aside class="colonne-appui" aria-label="Repères et accès rapides">
      <nav class="carte-appui" aria-labelledby="sommaire-titre">
        <p id="sommaire-titre" class="carte-appui-titre">
          Sur cette page
        </p>
        <div class="sommaire">
          {SOMMAIRE.map((e) => (
            <a href={`#${e.id}`}>{e.label}</a>
          ))}
        </div>
      </nav>

      <div class="carte-appui">
        <p class="carte-appui-titre">Les échéances</p>
        <dl class="mt-2 text-sm">
          {ECHEANCES_MARGE.map(({ libelle, e }) => (
            <div class="border-b border-border py-2">
              <dt class="text-ink-soft">{libelle}</dt>
              <dd class="font-semibold">{formatDateFr(e.date)}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-3 text-sm">
          <a href="/outils/echeance">Simuler ma situation</a>
        </p>
      </div>

      <div class="carte-appui">
        <p class="carte-appui-titre">Affiner la recommandation</p>
        <p class="mt-2 text-sm text-ink-soft">
          Votre métier est déjà renseigné. Il reste quatre questions : statut, volume de factures,
          compte professionnel et expert-comptable.
        </p>
        <p class="mt-3 text-sm">
          <a href={`/outils/quiz?metier=${encodeURIComponent(d.slug)}`} class="lien-fleche">
            Faire le quiz
          </a>
        </p>
      </div>
    </aside>
  </div>
</Base>
