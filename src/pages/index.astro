---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Quiz from '../components/islands/Quiz.tsx';
import Picto, { type NomPicto } from '../components/Picto.astro';
import HeroFlux from '../components/HeroFlux.astro';
import Ticker from '../components/Ticker.astro';
import StatTile from '../components/StatTile.astro';
import BandeauTransparence from '../components/BandeauTransparence.astro';
import { SITE } from '../config';
import { pageTitle } from '../lib/seo';
import { formatDateFr } from '../lib/dates';
import { compterSourcesGouv } from '../lib/presentation';
import { libelleStatutTest } from '../lib/statut-test';
import { FAMILLE_LABELS, type Famille } from '../lib/familles';
import hubs from '../data/hubs.json';
import echeances from '../data/echeances.json';

const title = pageTitle('Facturation électronique par métier', SITE.name);

const metiersColl = await getCollection('metiers');
const outilsColl = await getCollection('outils');
const guides = (await getCollection('guides')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'fr'),
);

// Données du quiz (section 7 : quiz sur /outils/quiz ET sur l'accueil)
const metiersQuiz = metiersColl
  .map((m) => ({ nom: m.data.nom, slug: m.data.slug }))
  .sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));
const recosParMetier = Object.fromEntries(
  metiersColl.map((m) => [m.data.slug, m.data.outils_recommandes.map((o) => o.slug)]),
);
const outilsQuiz = outilsColl.map((o) => ({
  slug: o.data.slug,
  nom: o.data.nom,
  comptePro: o.data.fonctionnalites.compte_pro,
  compta: o.data.fonctionnalites.compta,
  lienExpertComptable: o.data.fonctionnalites.lien_expert_comptable,
  cibles: o.data.cible.map((c) => c.toLowerCase()),
  urlOfficielle: o.data.url_officielle,
  libelleTest: libelleStatutTest(o.data.statut_test),
}));

// Badge du hero : dérivé d'echeances.json, seule source des dates de la réforme.
const premiereEcheance = [...echeances.echeances].sort((a, b) => a.date.localeCompare(b.date))[0];
if (!premiereEcheance) throw new Error('echeances.json : aucune échéance');
const badgeReforme =
  premiereEcheance.statut === 'en_vigueur'
    ? `Réforme en vigueur depuis le ${formatDateFr(premiereEcheance.date)}`
    : `Réforme applicable le ${formatDateFr(premiereEcheance.date)}`;

// Documents .gouv.fr distincts cités par le site : même calcul, sur les mêmes
// fichiers, que la présentation partenaires (scripts/build-presentation.ts).
const textesSources = Object.values(
  import.meta.glob<string>(['/src/content/**/*.{json,md,mdx}', '/src/data/**/*.json'], {
    query: '?raw',
    import: 'default',
    eager: true,
  }),
);

// Chiffres réels, calculés depuis les données du site — jamais inventés. Le
// registre des plateformes n'y figure pas : sa copie, tierce, compte aussi des
// dossiers en attente (TODO #8-10).
const stats = [
  {
    valeur: metiersColl.length,
    label: metiersColl.length > 1 ? 'métiers couverts' : 'métier couvert',
  },
  { valeur: compterSourcesGouv(textesSources), label: 'documents officiels (.gouv.fr) cités' },
  { valeur: outilsColl.length, label: 'logiciels comparés' },
];

const famillesActives = (Object.keys(FAMILLE_LABELS) as Famille[])
  .map((f) => ({
    famille: f,
    label: FAMILLE_LABELS[f],
    nb: metiersColl.filter((m) => m.data.famille === f).length,
    hub: f in hubs,
  }))
  .filter((f) => f.nb > 0);

const PREUVES: { titre: string; texte: string; href: string; picto: NomPicto }[] = [
  {
    titre: 'Classement indépendant',
    texte: 'Les commissions ne pèsent ni sur l’ordre ni sur les notes. Méthode publique.',
    href: '/methode',
    picto: 'medaille',
  },
  {
    titre: 'Données datées et sourcées',
    texte: 'Chaque affirmation réglementaire renvoie à une source officielle.',
    href: '/transparence',
    picto: 'document-source',
  },
  {
    titre: 'Tests réels documentés',
    texte: 'Aucune note avant un test réel : « Test à venir » est assumé.',
    href: '/methode',
    picto: 'loupe',
  },
];

const ETAPES: { n: string; titre: string; texte: string; picto: NomPicto }[] = [
  {
    n: '1',
    titre: 'Votre métier',
    texte: 'Chaque activité a ses règles : TVA, mentions, acomptes.',
    picto: 'profil',
  },
  {
    n: '2',
    titre: 'Votre recommandation',
    texte: '5 questions, 1 outil adapté + 2 alternatives.',
    picto: 'cible',
  },
  {
    n: '3',
    titre: 'Votre conformité',
    texte: 'Échéances, check-list et facture vérifiée.',
    picto: 'bouclier',
  },
];
---

<Base title={title} description={SITE.description}>
  <BandeauTransparence outils={outilsQuiz.map((o) => o.slug)} />
  <section class="hero pt-4">
    <div class="grid grid-cols-[minmax(0,1fr)] items-center gap-10 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div class="max-w-3xl">
        <p class="badge-ok badge-icone">
          <span class="m-point" aria-hidden="true"></span>
          {badgeReforme}
        </p>
        <h1 class="display-title m-mots mt-4">
          <span class="m-word">Le</span> <span class="m-word">bon</span>{' '}
          <span class="m-word">logiciel</span> <span class="m-word">de</span>{' '}
          <span class="m-word">facturation</span> <span class="m-word">électronique</span> <br />
          <span class="m-word">
            <span class="text-gradient m-reflet">pour votre métier</span>
          </span>
        </h1>
        <p class="prose-measure mt-5 text-lg">
          Plombier, infirmière libérale, développeur freelance… chaque métier facture différemment.
          Répondez à 5 questions et obtenez une recommandation fondée sur des faits vérifiés —
          jamais sur les commissions.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a href="/outils/quiz" class="btn-cta text-lg">
            Trouver mon logiciel en 5 questions
          </a>
          <a href="/outils/echeance" class="btn-ghost">
            Voir mes échéances
          </a>
        </div>
      </div>

      <div class="hidden lg:block">
        <HeroFlux />
      </div>
    </div>

    <ul class="mt-10 grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-3">
      {stats.map((s) => (
        <StatTile valeur={s.valeur} libelle={s.label} />
      ))}
    </ul>
  </section>

  {famillesActives.length > 0 && (
    <div class="mt-10">
      <Ticker familles={famillesActives.map((f) => f.famille)} />
    </div>
  )}

  <section
    aria-labelledby="quiz-accueil"
    class="card-top card-reco mt-12 max-w-2xl rounded-lg border border-border bg-paper p-5"
  >
    <h2 id="quiz-accueil" class="text-3xl font-extrabold">
      Votre recommandation en 5 questions
    </h2>
    <div class="mt-4">
      <Quiz client:idle metiers={metiersQuiz} outils={outilsQuiz} recosParMetier={recosParMetier} />
    </div>
  </section>

  <section aria-labelledby="etapes" class="mt-12">
    <h2 id="etapes" class="sr-only">
      Comment ça marche
    </h2>
    <ol class="m-etapes reveal grid gap-4 sm:grid-cols-3">
      {ETAPES.map((e) => (
        <li class="rounded-md border border-border p-4">
          <span class="picto-carre">
            <Picto nom={e.picto} />
          </span>
          <p class="mt-3 font-bold">
            <span class="text-gradient" aria-hidden="true">
              {e.n}.
            </span>{' '}
            {e.titre}
          </p>
          <p class="mt-1 text-sm text-ink-soft">{e.texte}</p>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="preuves" class="mt-12">
    <h2 id="preuves" class="titre-section text-2xl font-bold">
      Pourquoi nous faire confiance
    </h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-3">
      {PREUVES.map((p) => (
        <li class="m-lift reveal rounded-md border border-border bg-paper p-4">
          <span class="picto-carre m-pop-icon">
            <Picto nom={p.picto} />
          </span>
          <p class="mt-3 font-bold">{p.titre}</p>
          <p class="mt-1 text-sm text-ink-soft">{p.texte}</p>
          <p class="mt-2 text-sm">
            <a href={p.href}>En savoir plus</a>
          </p>
        </li>
      ))}
    </ul>
  </section>

  {famillesActives.length > 0 && (
    <section aria-labelledby="acces-familles" class="mt-12">
      <h2 id="acces-familles" class="titre-section text-2xl font-bold">
        Trouver votre métier
      </h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {famillesActives.map((f) => (
          <li class="m-fam flex items-center gap-3 rounded-md border border-border p-3">
            <span class="picto-carre picto-carre-sm m-pop-icon">
              <Picto nom={f.famille} taille={20} />
            </span>
            <span>
              {f.hub ? (
                <a href={`/metiers/${f.famille}`} class="lien-carte">
                  {f.label}
                </a>
              ) : (
                <span>{f.label}</span>
              )}{' '}
              <span class="text-sm text-ink-soft">
                · {f.nb} métier{f.nb > 1 ? 's' : ''}
              </span>
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="acces-outils" class="mt-12">
    <h2 id="acces-outils" class="titre-section text-2xl font-bold">
      Les logiciels passés au crible
    </h2>
    <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
      {outilsColl
        .sort((a, b) => a.data.nom.localeCompare(b.data.nom, 'fr'))
        .map((o) => (
          <li>
            <a href={`/logiciels/${o.data.slug}`}>{o.data.nom}</a>
          </li>
        ))}
    </ul>
  </section>

  {guides.length > 0 && (
    <section aria-labelledby="acces-guides" class="mt-12">
      <h2 id="acces-guides" class="titre-section text-2xl font-bold">
        Guides
      </h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {guides.map((g) => (
          <li>
            <a href={`/guides/${g.id}`}>{g.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="card-top mt-14 rounded-lg border border-border bg-paper-soft p-6 text-center">
    <h2 class="text-2xl font-bold">Prêt pour la facturation électronique ?</h2>
    <p class="mx-auto mt-2 max-w-xl text-ink-soft">
      Cinq questions pour trouver l'outil adapté à votre métier, deux pour connaître vos échéances.
    </p>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-4">
      <a href="/outils/quiz" class="btn-cta">
        Faire le quiz
      </a>
      <a href="/outils/verificateur-facture" class="btn-ghost">
        Vérifier ma facture
      </a>
    </div>
  </section>
</Base>
