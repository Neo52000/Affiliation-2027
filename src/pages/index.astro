---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Quiz from '../components/islands/Quiz.tsx';
import BandeauTransparence from '../components/BandeauTransparence.astro';
import EspacePublicitaire from '../components/EspacePublicitaire.astro';
import InscriptionNewsletter from '../components/InscriptionNewsletter.astro';
import ListeFamilles from '../components/ListeFamilles.astro';
import TableauOutils from '../components/TableauOutils.astro';
import { SITE } from '../config';
import { pageTitle } from '../lib/seo';
import { formatDateFr } from '../lib/dates';
import { compterSourcesGouv, insecables } from '../lib/presentation';
import { libelleStatutTest, phraseEtatTests } from '../lib/statut-test';
import { FAMILLE_LABELS, type Famille } from '../lib/familles';
import hubs from '../data/hubs.json';
import echeances from '../data/echeances.json';

const title = pageTitle('Facturation électronique par métier', SITE.name);

const metiersColl = await getCollection('metiers');
const outilsColl = await getCollection('outils');
const guides = (await getCollection('guides')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'fr'),
);

// Données du quiz, présent ici et sur /outils/quiz.
const metiersQuiz = metiersColl
  .map((m) => ({ nom: m.data.nom, slug: m.data.slug }))
  .sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));
const recosParMetier = Object.fromEntries(
  metiersColl.map((m) => [m.data.slug, m.data.outils_recommandes.map((o) => o.slug)]),
);
const outilsQuiz = outilsColl.map((o) => ({
  slug: o.data.slug,
  nom: o.data.nom,
  comptePro: o.data.fonctionnalites.compte_pro,
  compta: o.data.fonctionnalites.compta,
  lienExpertComptable: o.data.fonctionnalites.lien_expert_comptable,
  cibles: o.data.cible.map((c) => c.toLowerCase()),
  urlOfficielle: o.data.url_officielle,
  libelleTest: libelleStatutTest(o.data.statut_test),
}));

// Surtitre : l'obligation qui concerne toutes les entreprises (réception),
// datée et sourcée par echeances.json, seule source des dates de la réforme.
const reception = echeances.echeances.find((e) => e.id === 'reception-toutes-entreprises');
if (!reception) throw new Error('echeances.json : échéance de réception manquante');
const surtitre =
  reception.statut === 'en_vigueur'
    ? `Réception des factures électroniques obligatoire depuis le ${formatDateFr(reception.date)}`
    : `Réception des factures électroniques obligatoire à partir du ${formatDateFr(reception.date)}`;
const sourceReception = reception.sources[0];
if (!sourceReception) throw new Error('echeances.json : réception sans source');
const domaine = (url: string) => new URL(url).hostname.replace(/^www\./, '');

// Documents .gouv.fr distincts cités par le site : même calcul, sur les mêmes
// fichiers, que la présentation partenaires (scripts/build-presentation.ts).
const textesSources = Object.values(
  import.meta.glob<string>(['/src/content/**/*.{json,md,mdx}', '/src/data/**/*.json'], {
    query: '?raw',
    import: 'default',
    eager: true,
  }),
);
const nbSources = compterSourcesGouv(textesSources);

// Chiffres calculés depuis les données du site, jamais saisis. Le registre des
// plateformes n'y figure pas : sa copie, tierce, compte aussi des dossiers en
// attente (TODO #8-10).
const pluriel = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;
const faits = [
  pluriel(metiersColl.length, 'métier'),
  `${pluriel(nbSources, 'source')} .gouv.fr`,
  pluriel(outilsColl.length, 'logiciel'),
];

const famillesActives = (Object.keys(FAMILLE_LABELS) as Famille[])
  .map((f) => ({
    famille: f,
    label: FAMILLE_LABELS[f],
    nb: metiersColl.filter((m) => m.data.famille === f).length,
    hub: f in hubs,
  }))
  .filter((f) => f.nb > 0);

const tableauOutils = outilsColl.map((o) => ({
  slug: o.data.slug,
  nom: o.data.nom,
  agree: o.data.est_plateforme_agreee.valeur,
  comptePro: o.data.fonctionnalites.compte_pro,
  compta: o.data.fonctionnalites.compta,
  statutTest: o.data.statut_test,
}));
const sourcesAgrement = [
  ...new Set(outilsColl.flatMap((o) => o.data.est_plateforme_agreee.source ?? [])),
];

const nbTestes = outilsColl.filter((o) => o.data.statut_test === 'teste').length;
const etatTests = phraseEtatTests(outilsColl.length, nbTestes);
---

<Base title={title} description={SITE.description}>
  <BandeauTransparence outils={outilsQuiz.map((o) => o.slug)} rappelIndependance={false} />

  <header class="mt-6">
    <p class="surtitre">
      {insecables(surtitre)}&nbsp;·{' '}
      <a href={sourceReception} rel="noopener" class="font-normal">
        source {domaine(sourceReception)}
      </a>
    </p>
    <h1 class="titre-une mt-4">
      Le logiciel de facturation électronique qui convient à votre métier.
    </h1>
    <p class="chapo mt-5">
      Une infirmière libérale ne facture pas comme un plombier. Chaque fiche métier part des règles
      de facturation propres à l’activité, avec leurs sources officielles, puis indique les
      logiciels qui y répondent.
    </p>
    <hr class="mt-8 border-ink" />
    <ul class="faits chiffres mt-4 text-ink-soft">
      {faits.map((f) => (
        <li>{f}</li>
      ))}
    </ul>
    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="/outils/quiz" class="btn-cta">
        Trouver mon logiciel
      </a>
      <a href="/outils/echeance" class="lien-fleche">
        Voir mon échéance
      </a>
    </div>
  </header>

  {famillesActives.length > 0 && (
    <section aria-labelledby="acces-familles" class="mt-16">
      <h2 id="acces-familles" class="titre-section">
        Trouver votre métier
      </h2>
      <ListeFamilles familles={famillesActives} class="mt-2 md:grid md:grid-cols-2 md:gap-x-12" />
    </section>
  )}

  <section aria-labelledby="quiz-accueil" class="mt-16">
    <h2 id="quiz-accueil" class="titre-section">
      Votre recommandation en cinq questions
    </h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Métier, statut, volume de factures, compte professionnel, expert-comptable&nbsp;: le quiz
      retient un logiciel et deux alternatives.
    </p>
    <div class="mt-6 max-w-2xl">
      <Quiz client:idle metiers={metiersQuiz} outils={outilsQuiz} recosParMetier={recosParMetier} />
    </div>
  </section>

  <section aria-labelledby="classement" class="mt-16">
    <h2 id="classement" class="titre-section">
      Comment nous classons
    </h2>
    <p class="prose-measure mt-4">
      La note sur 10 suit une pondération publiée, où la conformité pèse le plus.{' '}
      {insecables(etatTests)} <a href="/methode">Lire la méthode de notation</a>.
    </p>
    <p class="prose-measure mt-4">
      Les commissions d’affiliation et les espaces publicitaires financent le site&nbsp;; ils
      n’entrent ni dans la note ni dans l’ordre des recommandations.{' '}
      <a href="/transparence">Voir comment le site est financé</a>.
    </p>
  </section>

  <section aria-labelledby="acces-outils" class="mt-16">
    <h2 id="acces-outils" class="titre-section">
      Les logiciels comparés
    </h2>
    <div class="mt-4">
      <TableauOutils outils={tableauOutils} />
    </div>
    {sourcesAgrement.length > 0 && (
      <p class="mt-3 text-sm text-ink-soft">
        Statut de plateforme agréée relevé sur le registre de l’administration fiscale&nbsp;:{' '}
        {sourcesAgrement.map((s, i) => (
          <>
            {i > 0 && ', '}
            <a href={s} rel="noopener">
              {domaine(s)}
            </a>
          </>
        ))}
        .
      </p>
    )}
  </section>

  {guides.length > 0 && (
    <section aria-labelledby="acces-guides" class="mt-16">
      <h2 id="acces-guides" class="titre-section">
        Guides
      </h2>
      <ul class="liste-filets mt-2 md:grid md:grid-cols-2 md:gap-x-12">
        {guides.map((g) => (
          <li>
            <a href={`/guides/${g.id}`} class="font-semibold">
              {insecables(g.data.title)}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <InscriptionNewsletter
    id="nl-accueil"
    titre="Suivre la réforme par email"
    class="prose-measure mt-16"
  />

  <EspacePublicitaire emplacement="accueil" class="mt-16" />
</Base>
