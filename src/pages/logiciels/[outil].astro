---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import Statut from '../../components/Statut.astro';
import StatutPlateforme from '../../components/StatutPlateforme.astro';
import BandeauTransparence from '../../components/BandeauTransparence.astro';
import { ORDRE_COMPARATIFS, urlComparatif } from '../../lib/comparatifs';
import { libelleStatutTest } from '../../lib/statut-test';
import { formatDateFr } from '../../lib/dates';
import { de } from '../../lib/typographie';
import { jsonLdSur, pageTitle } from '../../lib/seo';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const outils = await getCollection('outils');
  return outils.map((o) => ({ params: { outil: o.data.slug }, props: { entry: o } }));
}

const { entry } = Astro.props;
const d = entry.data;

const FONCTIONNALITES: { cle: keyof typeof d.fonctionnalites; label: string }[] = [
  { cle: 'emission', label: 'Émission de factures électroniques' },
  { cle: 'reception', label: 'Réception de factures électroniques' },
  { cle: 'e_reporting', label: 'E-reporting' },
  { cle: 'compte_pro', label: 'Compte professionnel' },
  { cle: 'compta', label: 'Comptabilité' },
  { cle: 'devis', label: 'Devis' },
  { cle: 'acomptes', label: 'Factures d’acompte' },
  { cle: 'app_mobile', label: 'Application mobile' },
  { cle: 'export_comptable', label: 'Export comptable' },
  { cle: 'lien_expert_comptable', label: 'Accès expert-comptable' },
];

const pageTarifs = d.sources.find((s) => s.objet.toLowerCase().includes('tarif'));
const libelleTest = libelleStatutTest(d.statut_test);

// Le premier point fort (statut de plateforme agréée) est identique pour les six
// outils et déjà rendu par StatutPlateforme : l'essentiel retient le suivant.
const pointFortDistinctif = d.points_forts.find((p) => !/plateforme agréée/i.test(p));

// Les 5 comparatifs de l'outil, dans l'ordre stable des URL.
const outilsColl = await getCollection('outils');
const comparatifs = (ORDRE_COMPARATIFS as readonly string[])
  .filter((slug) => slug !== d.slug)
  .flatMap((slug) => {
    const autre = outilsColl.find((o) => o.data.slug === slug);
    return autre ? [{ url: urlComparatif(d.slug, slug), nom: autre.data.nom }] : [];
  });

// Protocole du test réel (collection tests) : aucune étape n'est marquée faite
// tant que le test n'a pas été mené et publié.
const test = (await getCollection('tests')).find((t) => t.data.outil_slug === d.slug);
// Un seul prédicat pour la phrase et la liste (la concordance des deux fiches
// est vérifiée par src/lib/data.test.ts, la date par le schéma).
const teste =
  d.statut_test === 'teste' && test?.data.statut === 'teste' && test.data.date_test !== null;
const plansRenseignes = d.plans.filter(
  (p) => p.prix_ht_mensuel !== null && p.date_releve !== null && p.url_source !== null,
);
// Une offre déclarée mais pas encore relevée est nommée, jamais omise.
const plansARelever = d.plans.filter((p) => !plansRenseignes.includes(p));

// JSON-LD SoftwareApplication, sans AggregateRating ni prix inventés (section 9).
const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: d.nom,
  url: d.url_officielle,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
};
---

<Base
  title={pageTitle(`${d.nom} : avis et conformité`, SITE.name)}
  description={`${d.nom} pour la facturation électronique : statut de plateforme agréée, fonctionnalités vérifiées, pour qui. Données datées et sourcées.`}
>
  <script type="application/ld+json" is:inline set:html={jsonLdSur(appJsonLd)} />
  <BandeauTransparence outils={[d.slug]} />
  <Breadcrumb items={[{ label: 'Logiciels' }, { label: d.nom }]} />

  <div class="layout-article mt-4">
    <article>
      <p class="surtitre">Fiche logiciel · {libelleTest}</p>
      <h1 class="titre-page mt-3">{d.nom} et facturation électronique</h1>
      <p class="mt-3 text-sm text-ink-soft">Mis à jour le {formatDateFr(d.date_maj)}</p>

      <section aria-labelledby="en-bref-outil" class="en-bref prose-measure mt-6">
        <h2 id="en-bref-outil" class="etiquette">
          En bref
        </h2>
        <ul class="mt-2 space-y-2">
          <li>Cible revendiquée par l'éditeur : {d.cible.join(', ')}.</li>
          {pointFortDistinctif && <li>{pointFortDistinctif.replace(/\.$/, '')}.</li>}
        </ul>
        <StatutPlateforme statut={d.est_plateforme_agreee} nom={d.nom} variante="complet" />
      </section>

      <section aria-labelledby="fonctionnalites" class="mt-10">
        <h2 id="fonctionnalites" class="titre-section">
          Fonctionnalités
        </h2>
        <div
          class="table-scroll mt-4 max-w-xl"
          role="region"
          aria-label="Tableau des fonctionnalités"
          tabindex="0"
        >
          <table class="w-full border-collapse text-sm">
            <caption class="sr-only">{`Fonctionnalités ${de(d.nom)}`}</caption>
            <tbody>
              {FONCTIONNALITES.map((f) => (
                <tr>
                  <th scope="row" class="py-2 pr-3 text-left font-normal">
                    {f.label}
                  </th>
                  <td class="py-2">
                    <Statut valeur={d.fonctionnalites[f.cle]} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-sm text-ink-soft">
          « À vérifier » : donnée en cours de relevé sur le site officiel de l'éditeur.
        </p>
      </section>

      <section aria-labelledby="tarifs" class="mt-10">
        <h2 id="tarifs" class="titre-section">
          Tarifs
        </h2>
        {plansRenseignes.length > 0 && (
          <div class="table-scroll mt-4" role="region" aria-label="Tableau des tarifs" tabindex="0">
            <table class="table-chiffres w-full border-collapse text-sm">
              <thead>
                <tr>
                  <th scope="col" class="designation py-2 pr-3 text-left">
                    Offre
                  </th>
                  <th scope="col" class="nombre py-2 pr-3">
                    Prix HT par mois
                  </th>
                  <th scope="col" class="py-2 text-left">
                    Relevé
                  </th>
                </tr>
              </thead>
              <tbody>
                {plansRenseignes.map((p) => (
                  <tr>
                    <th scope="row" class="designation py-2 pr-3 text-left font-normal">
                      {p.nom}
                    </th>
                    <td class="nombre py-2 pr-3">
                      {new Intl.NumberFormat('fr-FR', {
                        style: 'currency',
                        currency: 'EUR',
                      }).format(p.prix_ht_mensuel ?? 0)}
                    </td>
                    <td class="py-2">
                      <a href={p.url_source ?? undefined} rel="noopener">
                        le {formatDateFr(p.date_releve ?? '')}
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {plansRenseignes.length === 0 || plansARelever.length > 0 ? (
          <p class="prose-measure mt-3">
            {plansRenseignes.length === 0
              ? 'Les prix sont en cours de relevé, avec date et source pour chaque donnée.'
              : `Prix en cours de relevé pour : ${plansARelever.map((p) => p.nom).join(', ')}.`}
            {pageTarifs && (
              <>
                {' '}
                En attendant, consultez la{' '}
                <a href={pageTarifs.url} rel="noopener">
                  page tarifs officielle
                </a>
                .
              </>
            )}
          </p>
        ) : null}
      </section>

      <section aria-labelledby="pour-qui" class="mt-10">
        <h2 id="pour-qui" class="titre-section">
          Points forts
        </h2>
        <ul class="liste-filets prose-measure mt-2">
          {d.points_forts.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
        <h3 class="mt-6">Quand regarder ailleurs</h3>
        <p class="prose-measure mt-2">
          Si votre profil n'entre pas dans la cible revendiquée par l'éditeur, comparez d'abord avec
          les logiciels pensés pour lui. Cette partie sera complétée après notre test.
        </p>
      </section>

      {comparatifs.length > 0 && (
        <section aria-labelledby="comparer-outil" class="mt-10">
          <h2 id="comparer-outil" class="titre-section">
            Comparer {d.nom}
          </h2>
          <ul class="liste-filets mt-2 md:grid md:grid-cols-2 md:gap-x-12">
            {comparatifs.map((c) => (
              <li>
                <a href={c.url}>
                  {d.nom} ou {c.nom}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {test && (
        <section aria-labelledby="protocole-outil" class="mt-10">
          <h2 id="protocole-outil" class="titre-section">
            Notre test, étape par étape
          </h2>
          <p class="prose-measure mt-3 text-sm text-ink-soft">
            {teste && test.data.date_test
              ? `Test mené le ${formatDateFr(test.data.date_test)} : ${test.data.protocole.length} étapes sur ${test.data.protocole.length}.`
              : `${libelleStatutTest('a_tester')} : aucune des ${test.data.protocole.length} étapes n'est encore réalisée. Aucune note n'est publiée avant.`}
          </p>
          <ol class="prose-measure mt-2">
            {test.data.protocole.map((etape, i) => (
              <li class="numerote border-b border-border py-3">
                <span class="numero numero-petit" aria-hidden="true">
                  {i + 1}
                </span>
                <p>{etape}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      <section aria-labelledby="sources-outil" class="mt-10">
        <h2 id="sources-outil" class="titre-section">
          Sources
        </h2>
        <ol class="prose-measure mt-3 list-decimal space-y-1 pl-5 text-sm">
          {d.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener">
                {s.objet}
              </a>
              , relevé le {formatDateFr(s.date_releve)}
            </li>
          ))}
        </ol>
      </section>
    </article>

    <aside class="colonne-appui" aria-label="Accès rapides">
      <div class="carte-appui">
        <p class="carte-appui-titre">Site de l'éditeur</p>
        <p class="mt-2 text-sm text-ink-soft">
          Vérifiez les tarifs et le périmètre à la source avant de vous engager.
        </p>
        <div class="mt-3">
          <AffiliateButton
            outil={d.slug}
            urlOfficielle={d.url_officielle}
            label={`Aller sur le site ${de(d.nom)}`}
            emplacement={`fiche-${d.slug}`}
          />
        </div>
      </div>

      <div class="carte-appui">
        <p class="carte-appui-titre">Affiner avec le quiz</p>
        <p class="mt-2 text-sm text-ink-soft">
          Cinq questions pour savoir si ce logiciel correspond à votre métier.
        </p>
        <p class="mt-3 text-sm">
          <a href="/outils/quiz" class="lien-fleche">
            Faire le quiz
          </a>
        </p>
      </div>
    </aside>
  </div>
</Base>
