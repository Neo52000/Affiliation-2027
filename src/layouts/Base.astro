---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  updatedAt?: Date;
  noindex?: boolean;
}

const { title, description, updatedAt, noindex } = Astro.props;

// Le script de tête pose la classe `js` avant le premier rendu : les éléments qui
// n'ont de sens qu'avec JavaScript (sélecteur de métier, filtre du registre)
// restent masqués sans lui. Il est autorisé par empreinte CSP (postbuild).
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121411" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-instrument" preload />
    <Seo title={title} description={description} updatedAt={updatedAt} noindex={noindex} />
  </head>
  <body>
    <a href="#contenu" class="skip-link">
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
