---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter700 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
import inter800 from '@fontsource/inter/files/inter-latin-800-normal.woff2?url';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CLE_ANIMATIONS, VALEUR_PAUSE } from '../lib/animations';

interface Props {
  title: string;
  description: string;
  updatedAt?: Date;
  noindex?: boolean;
}

const { title, description, updatedAt, noindex } = Astro.props;

// Le script de tête pose `js`, puis `anim-on` ou `anim-pause` selon la préférence
// mémorisée (bouton de l'en-tête), avant le premier rendu. Sans JavaScript, aucune
// de ces classes n'existe et rien ne boucle. Il est autorisé par empreinte CSP.
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ cle: CLE_ANIMATIONS, pause: VALEUR_PAUSE }}>
      const racine = document.documentElement;
      let stockee = null;
      try {
        stockee = localStorage.getItem(cle);
      } catch {
        // Stockage bloqué : les animations restent actives, le bouton reste disponible.
      }
      racine.classList.add('js', stockee === pause ? 'anim-pause' : 'anim-on');
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href={inter400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter800} crossorigin />
    <Seo title={title} description={description} updatedAt={updatedAt} noindex={noindex} />
  </head>
  <body>
    <a href="#contenu" class="skip-link">
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
    <Footer />
    <script>
      // Révélation d'entrée (design system, Mouvement, geste 4) et compteurs des
      // chiffres clés. L'état masqué n'est posé que si l'observateur est actif,
      // et jamais sur un élément déjà visible au chargement : sans JavaScript,
      // avec prefers-reduced-motion ou au-dessus de la ligne de flottaison, le
      // contenu est lisible d'emblée (aucun effet sur le LCP).
      const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const enPause = document.documentElement.classList.contains('anim-pause');
      const format = new Intl.NumberFormat('fr-FR');

      const compter = (el: HTMLElement) => {
        const fin = Number(el.dataset.compteur);
        if (!Number.isFinite(fin) || fin <= 0) return;
        const debut = performance.now();
        const duree = 1200;
        const pas = (t: number) => {
          const p = Math.min(1, (t - debut) / duree);
          el.textContent = format.format(Math.round(fin * (1 - (1 - p) ** 3)));
          if (p < 1) requestAnimationFrame(pas);
        };
        requestAnimationFrame(pas);
      };

      if ('IntersectionObserver' in window && !reduit) {
        const visible = (el: Element) => {
          const r = el.getBoundingClientRect();
          return r.top < window.innerHeight && r.bottom > 0;
        };

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              if (el.dataset.compteur !== undefined) compter(el);
              else el.classList.add('reveal-in');
              io.unobserve(el);
            }
          },
          { threshold: 0.1 },
        );

        for (const el of document.querySelectorAll('.reveal')) {
          if (visible(el)) continue;
          el.classList.add('reveal-ready');
          io.observe(el);
        }
        // Un compte est une animation courte lancée au temps, jamais liée au
        // défilement ; la pause des animations le supprime.
        if (!enPause) {
          for (const el of document.querySelectorAll<HTMLElement>('[data-compteur]'))
            io.observe(el);
        }
      }
    </script>
  </body>
</html>
